---
import Layout from '~/layouts/PageLayout.astro';
import { getCollection } from 'astro:content';
import { findImage } from '~/utils/images';

const metadata = {
  title: 'Trade Compliance News & Intelligence | TradeShield AI',
  description: 'Real-time sanctions, export controls, tariffs and trade enforcement intelligence. OFAC, BIS, CBP, EU — curated weekly for importers, exporters and freight professionals.',
  ignoreTitleTemplate: true,
};

import defaultImg from '~/assets/images/TradeShield-AI.jpg';

const allPosts = await getCollection('post');
const sorted = allPosts
  .filter(p => !p.data.draft)
  .sort((a, b) => new Date(b.data.publishDate ?? 0).getTime() - new Date(a.data.publishDate ?? 0).getTime());

// Pre-resolve ~/assets/... image paths to real URLs at build time
const resolvedImgSrc = new Map<string, string>();
await Promise.all(sorted.map(async p => {
  const img = await findImage(p.data.image);
  resolvedImgSrc.set(p.id, img && typeof img !== 'string' ? (img as any).src : (img as string | undefined) ?? defaultImg.src);
}));

// Weekly 9: top 9 in the main grid, the rest in Related Intelligence
const weekly9  = sorted.slice(0, 9);
const related  = sorted.slice(9);
---
<Layout metadata={metadata}>

<!-- ═══ HERO ═══ -->
<section style="background:linear-gradient(135deg,#030a14 0%,#0b1e3d 60%,#0a7c6e18 100%);padding:72px 24px 48px;text-align:center;position:relative;overflow:hidden">
  <div style="position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,0.03) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.03) 1px,transparent 1px);background-size:40px 40px;pointer-events:none"></div>
  <div style="position:relative;max-width:720px;margin:0 auto">
    <span style="display:inline-flex;align-items:center;gap:6px;font-size:11px;font-weight:700;letter-spacing:.12em;color:#34d399;background:#34d39912;border:1px solid #34d39935;padding:5px 14px;border-radius:20px;margin-bottom:20px">
      <span style="width:6px;height:6px;border-radius:50%;background:#34d399;animation:tspulse 2s infinite"></span>
      LIVE INTELLIGENCE FEED
    </span>
    <h1 style="font-size:clamp(32px,5vw,52px);font-weight:900;color:#f1f5f9;line-height:1.12;margin-bottom:16px;letter-spacing:-.02em">
      TradeShield AI<br>Compliance Intelligence
    </h1>
    <p style="color:#94a3b8;font-size:16px;max-width:500px;margin:0 auto;line-height:1.6">
      Sanctions · Export Controls · Tariffs · Enforcement — real-time intelligence for importers, exporters and freight professionals.
    </p>
  </div>
</section>

<!-- ═══ WEEKLY 9 — most recent briefings ═══ -->
<section style="background:#ffffff;border-top:1px solid #e2e8f0;padding:56px 24px 72px">
  <div style="max-width:1200px;margin:0 auto">
    <div style="margin-bottom:36px;display:flex;align-items:flex-end;justify-content:space-between;flex-wrap:wrap;gap:12px">
      <div>
        <span style="font-size:11px;font-weight:700;color:#0a7c6e;letter-spacing:.1em;text-transform:uppercase">Trade Weekly Intelligence Briefing</span>
        <h2 style="font-size:30px;font-weight:900;color:#0f172a;margin-top:6px;letter-spacing:-.01em">AI Trade Audit — Latest 9 Briefings</h2>
        <p style="color:#64748b;font-size:14px;margin-top:6px">AI-generated weekly briefings on sanctions, tariffs, and export controls</p>
      </div>
      <span style="font-size:10px;font-weight:700;color:#64748b;font-family:monospace;border:1px solid #e2e8f0;padding:4px 10px;border-radius:6px">{weekly9.length} of {sorted.length} articles</span>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px">
      {weekly9.map(post => (
        <a href={`/blog/${post.id}`}
          style="text-decoration:none;display:flex;flex-direction:column;border-radius:16px;overflow:hidden;background:#ffffff;border:1px solid #e2e8f0;transition:transform .15s,border-color .15s,box-shadow .15s"
          onmouseover="this.style.transform='translateY(-4px)';this.style.borderColor='#0a7c6e50';this.style.boxShadow='0 8px 32px rgba(10,124,110,0.10)'"
          onmouseout="this.style.transform='';this.style.borderColor='#e2e8f0';this.style.boxShadow='none'">
          <div style="aspect-ratio:16/7;overflow:hidden;background:#f1f5f9;flex-shrink:0">
            <img
              src={resolvedImgSrc.get(post.id) ?? defaultImg.src}
              alt={post.data.title}
              style="width:100%;height:100%;object-fit:cover;transition:opacity .2s"
              loading="lazy" />
          </div>
          <div style="padding:20px;display:flex;flex-direction:column;flex:1">
            {post.data.category && (
              <span style="font-size:10px;font-weight:700;letter-spacing:.1em;color:#0a7c6e;background:#f0fdf9;border:1px solid #0a7c6e30;padding:2px 8px;border-radius:4px;text-transform:uppercase;width:fit-content;margin-bottom:10px">{post.data.category}</span>
            )}
            <h3 style="font-size:15px;font-weight:800;color:#0f172a;line-height:1.4;flex:1;margin-bottom:10px">{post.data.title}</h3>
            <p style="font-size:12px;color:#64748b;line-height:1.55;margin-bottom:16px">{post.data.excerpt?.slice(0,120)}{(post.data.excerpt?.length ?? 0) > 120 ? '…' : ''}</p>
            <div style="display:flex;align-items:center;justify-content:space-between;border-top:1px solid #e2e8f0;padding-top:12px">
              <span style="font-size:11px;color:#94a3b8;font-family:monospace">
                {post.data.publishDate ? new Date(post.data.publishDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : ''}
              </span>
              <span style="font-size:11px;color:#0a7c6e;font-weight:700">Read article →</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ═══ RELATED INTELLIGENCE (posts beyond the top 9) ═══ -->
{related.length > 0 && (
<section style="background:#f8fafc;border-top:1px solid #e2e8f0;padding:40px 24px 56px">
  <div style="max-width:1200px;margin:0 auto">
    <div style="margin-bottom:24px">
      <span style="font-size:11px;font-weight:700;color:#94a3b8;letter-spacing:.1em;text-transform:uppercase">Related Intelligence</span>
      <h3 style="font-size:22px;font-weight:800;color:#334155;margin-top:4px">Earlier Briefings</h3>
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(260px,1fr));gap:16px">
      {related.map(post => (
        <a href={`/blog/${post.id}`}
          style="text-decoration:none;display:flex;gap:12px;align-items:flex-start;background:#ffffff;border:1px solid #e2e8f0;border-radius:12px;padding:14px;transition:border-color .15s"
          onmouseover="this.style.borderColor='#0a7c6e50'"
          onmouseout="this.style.borderColor='#e2e8f0'">
          <div style="width:48px;height:48px;flex-shrink:0;border-radius:8px;overflow:hidden;background:#f1f5f9">
            <img src={resolvedImgSrc.get(post.id) ?? defaultImg.src}
              alt="" style="width:100%;height:100%;object-fit:cover" loading="lazy" />
          </div>
          <div style="flex:1;min-width:0">
            <p style="font-size:13px;font-weight:700;color:#334155;line-height:1.4;margin:0 0 6px;overflow:hidden;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical">{post.data.title}</p>
            <span style="font-size:10px;color:#94a3b8;font-family:monospace">
              {post.data.publishDate ? new Date(post.data.publishDate).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) : ''}
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
)}

<style is:global>
@keyframes tspulse { 0%,100% { opacity:1; } 50% { opacity:.3; } }
</style>

</Layout>
