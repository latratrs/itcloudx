---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Services — TradeShield AI | AI Trade Compliance Tools',
  description: 'TradeShield AI offers HS code classification, OFAC sanctions screening, tariff intelligence, and PDF compliance reports. AI-powered tools for importers, exporters, freight forwarders and customs brokers.',
};
---
<Layout metadata={metadata}>
  <section class="py-16 px-4 max-w-5xl mx-auto">
    <h1 class="text-4xl font-bold mb-4 text-center">TradeShield AI Services</h1>
    <p class="text-xl text-center text-muted dark:text-slate-400 mb-12">
      AI-powered trade compliance tools for importers, exporters, freight forwarders, and customs brokers.
    </p>

    <div class="grid md:grid-cols-2 gap-8">

      <div class="rounded-xl border border-blue-900 bg-[#0b1e3d] p-6">
        <div class="text-3xl mb-3">🔍</div>
        <h2 class="text-xl font-bold mb-2">HS Code Classification</h2>
        <p class="text-slate-400">Upload any invoice, product list, or manifest. Our AI returns the correct 10-digit HTS code for every product with confidence score and duty rate from live CBP data.</p>
      </div>

      <div class="rounded-xl border border-blue-900 bg-[#0b1e3d] p-6">
        <div class="text-3xl mb-3">🛡️</div>
        <h2 class="text-xl font-bold mb-2">OFAC & Sanctions Screening</h2>
        <p class="text-slate-400">Real-time screening against OFAC SDN, UN, and EU consolidated sanctions lists. Flags restricted parties, countries, and entities before your shipment moves.</p>
      </div>

      <div class="rounded-xl border border-blue-900 bg-[#0b1e3d] p-6">
        <div class="text-3xl mb-3">📊</div>
        <h2 class="text-xl font-bold mb-2">Tariff Intelligence</h2>
        <p class="text-slate-400">Automatic duty rate calculation including Section 301, 232, and 201 tariffs. Get alerted when tariff rates change for your specific HS codes.</p>
      </div>

      <div class="rounded-xl border border-blue-900 bg-[#0b1e3d] p-6">
        <div class="text-3xl mb-3">📄</div>
        <h2 class="text-xl font-bold mb-2">PDF Compliance Reports</h2>
        <p class="text-slate-400">Downloadable audit-ready PDF reports with explainable AI chain-of-thought. Show customs brokers and CBP exactly why each code was assigned.</p>
      </div>

      <div class="rounded-xl border border-blue-900 bg-[#0b1e3d] p-6">
        <div class="text-3xl mb-3">📦</div>
        <h2 class="text-xl font-bold mb-2">Bulk Document Processing</h2>
        <p class="text-slate-400">Upload CSV or Excel files with hundreds of SKUs. Get back a complete compliance report for your entire product catalog in under 60 seconds.</p>
      </div>

      <div class="rounded-xl border border-blue-900 bg-[#0b1e3d] p-6">
        <div class="text-3xl mb-3">🔔</div>
        <h2 class="text-xl font-bold mb-2">Regulatory Change Alerts</h2>
        <p class="text-slate-400">Register your product catalog once. Get email alerts whenever a relevant tariff, sanction, or export control changes — before it impacts your shipments.</p>
      </div>

    </div>

    <div class="text-center mt-12">
      <a href="/pricing" class="inline-block bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg mr-4">View Pricing</a>
      <a href="/audit" class="inline-block border border-blue-500 text-blue-400 hover:text-white font-bold py-3 px-8 rounded-lg">Try Free Scan</a>
    </div>
  </section>
</Layout>
