---
import Layout from '~/layouts/PageLayout.astro';
import ScanWidget from '~/components/widgets/ScanWidget.astro';

export const prerender = true;

const metadata = {
  title: 'Free Vision Audit – TradeShield AI',
  description:
    'Upload shipping documents or product images for instant Google Cloud Vision analysis: OCR, object detection, label detection, and barcode extraction.',
  robots: 'noindex',
};
---

<Layout metadata={metadata}>
  <section class="min-h-screen bg-gradient-to-b from-white to-[#f7f5f0] dark:from-gray-950 dark:to-gray-900 transition-colors duration-300">
    <div class="max-w-4xl mx-auto px-6 py-16 md:py-24 space-y-12">

      <!-- Page heading -->
      <div class="text-center">
        <span class="inline-block bg-teal-100 dark:bg-teal-900/30 text-teal-700 dark:text-teal-300 text-xs font-bold uppercase tracking-widest px-4 py-1.5 rounded-full mb-4">
          Powered by Google Cloud Vision API
        </span>
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-900 dark:text-white leading-tight">
          Free Vision Audit
        </h1>
        <p class="mt-6 text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Upload any shipping document, invoice, or product image. Get instant AI analysis powered by
          <strong>Google Cloud Vision</strong>: OCR, object detection, label detection, and barcode extraction.
        </p>
      </div>

      <!-- Capability chips -->
      <div class="flex flex-wrap justify-center gap-3">
        <span class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-sm font-semibold px-4 py-2 rounded-full shadow-sm">
          🔤 Full-document OCR
        </span>
        <span class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-sm font-semibold px-4 py-2 rounded-full shadow-sm">
          🏷️ Label detection
        </span>
        <span class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-sm font-semibold px-4 py-2 rounded-full shadow-sm">
          📦 Object localization
        </span>
        <span class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-sm font-semibold px-4 py-2 rounded-full shadow-sm">
          🔲 Barcode &amp; QR extraction
        </span>
        <span class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 text-gray-700 dark:text-gray-300 text-sm font-semibold px-4 py-2 rounded-full shadow-sm">
          📄 PDF support
        </span>
      </div>

      <!-- Scan widget -->
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-xl border border-gray-200 dark:border-gray-700 p-6 md:p-10">
        <ScanWidget heading="Vision Audit Tool" />
      </div>

      <!-- How it works -->
      <div class="bg-white dark:bg-gray-800 rounded-3xl shadow border border-gray-200 dark:border-gray-700 p-8">
        <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 text-center">How It Works</h2>
        <div class="grid md:grid-cols-4 gap-6">
          <div class="text-center">
            <div class="text-4xl mb-3">📤</div>
            <div class="font-bold text-gray-900 dark:text-white mb-1">1. Upload</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">Drop an image (JPG, PNG, TIFF) or PDF</div>
          </div>
          <div class="text-center">
            <div class="text-4xl mb-3">☁️</div>
            <div class="font-bold text-gray-900 dark:text-white mb-1">2. Vision API</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">Google Cloud Vision analyzes the file</div>
          </div>
          <div class="text-center">
            <div class="text-4xl mb-3">🔍</div>
            <div class="font-bold text-gray-900 dark:text-white mb-1">3. Extract</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">OCR, labels, objects, and barcodes returned</div>
          </div>
          <div class="text-center">
            <div class="text-4xl mb-3">✅</div>
            <div class="font-bold text-gray-900 dark:text-white mb-1">4. Review</div>
            <div class="text-sm text-gray-500 dark:text-gray-400">Tabbed results — copy, use, or export</div>
          </div>
        </div>
      </div>

      <!-- CTA -->
      <div class="text-center">
        <p class="text-gray-500 dark:text-gray-400 mb-4">
          Want the full compliance analysis — HS codes, sanctions, tariff rates?
        </p>
        <a
          href="/pricing"
          class="inline-flex items-center gap-2 bg-teal-600 hover:bg-teal-700 text-white font-bold px-8 py-3 rounded-xl shadow transition"
        >
          Upgrade to Pro → $299/mo
        </a>
      </div>

    </div>
  </section>
</Layout>
