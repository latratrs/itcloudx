---
import Layout from '~/layouts/PageLayout.astro';
const metadata = {
  title: 'Free Compliance Audit – TradeShield AI',
  description: 'Upload shipping documents for instant AI-powered HS code classification, sanctions screening, and customs compliance analysis.',
  robots: { index: true },
};
---
<Layout metadata={metadata}>
  <section class="min-h-screen bg-gradient-to-b from-white to-[#f7f5f0] dark:from-gray-950 dark:to-gray-900 transition-colors duration-300">
    <div class="max-w-5xl mx-auto px-6 py-16 md:py-24">
      <div id="screen-upload" class="space-y-12">
        <div class="text-center">
          <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-900 dark:text-white leading-tight">
            Free Compliance Audit
          </h1>
          <p class="mt-6 text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
            Upload any shipping document (PDF, CSV, Excel, image). Get instant AI analysis: HS codes, duty rates, sanctions flags, and a clear action plan.
          </p>
        </div>
        <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-xl border border-gray-200 dark:border-gray-700 p-8 md:p-12">
          <div id='google-signin-btn' style='text-align:center;padding:32px 24px;display:flex;flex-direction:column;align-items:center;gap:16px'>
            <div style='font-size:48px'>🔐</div>
            <h3 style='font-size:18px;font-weight:800;color:#0b1e3d;margin:0'>Sign in to start your free scan</h3>
            <p style='font-size:13px;color:#64748b;margin:0'>5 free scans per month · No credit card required</p>
            <button onclick='if(typeof firebase==="undefined"){alert("Auth loading, please try again");return;}window.signInWithGoogle();' style='display:flex;align-items:center;gap:10px;background:white;border:2px solid #e2e8f0;border-radius:12px;padding:12px 24px;font-size:14px;font-weight:700;color:#0b1e3d;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.08)'>
              <svg width=20 height=20 viewBox='0 0 48 48'><path fill='#EA4335' d='M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z'/><path fill='#4285F4' d='M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z'/><path fill='#FBBC05' d='M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z'/><path fill='#34A853' d='M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z'/></svg>
              Continue with Google
            </button>
          </div>
          <div id='signed-in-user' style='display:none;align-items:center;justify-content:space-between;padding:10px 16px;background:#f0fdf4;border:1px solid #86efac;border-radius:12px;margin-bottom:16px'>
            <span style='font-size:13px;color:#166534;font-weight:600'>✅ Signed in as <span id='user-email-display'></span></span>
            <button onclick='signOut()' style='font-size:11px;color:#64748b;background:none;border:none;cursor:pointer;text-decoration:underline'>Sign out</button>
          </div>
          <div id='scan-form-section' style='display:none'>
          <div id="drop-zone" class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-2xl p-12 text-center cursor-pointer hover:border-teal-500 dark:hover:border-teal-400 transition-colors" ondrop="handleDrop(event)" ondragover="handleDragOver(event)" onclick="document.getElementById('file-input').click()">
            <input type="file" id="file-input" accept=".pdf,.csv,.xlsx,.xls,.doc,.docx,.rtf,.ods,.html,.htm,.jpg,.jpeg,.png,.gif,.tiff,.tif,.webp" class="hidden" onchange="handleFileSelect(event)">
            <div id="drop-idle">
              <div class="text-6xl mb-6">📄</div>
              <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-2">Drop your document here</h3>
              <p class="text-gray-500 dark:text-gray-400">PDF · CSV · Excel · JPG · PNG · TIFF (max 25MB)</p>
              <p class='text-xs text-gray-400 mt-3 leading-relaxed'>✅ Best results: PDF invoices, Excel manifests, CSV product lists, JPG/PNG photos<br>⚠️ Limited support: RTF, HTML, GIF — may return lower confidence</p>
              <button class="mt-6 px-8 py-3 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-xl transition">Choose File</button>
            </div>
            <div id="drop-ready" class="hidden">
              <div class="text-6xl mb-6">📎</div>
              <h3 id="drop-filename" class="text-xl font-bold text-gray-900 dark:text-white mb-2"></h3>
              <p id="drop-filesize" class="text-gray-500 dark:text-gray-400"></p>
              <button onclick="clearFile()" class="mt-6 text-red-600 dark:text-red-400 hover:text-red-700 font-medium">Remove file</button>
            </div>
          </div>
          <div class="mt-8 grid md:grid-cols-2 gap-6">
            <div>
              <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-2">Company / Consignee Name <span style='color:#ef4444'>*</span></label>
              <input type="text" id="company" required class="w-full px-4 py-3 border border-gray-300 dark:border-gray-600 rounded-xl bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-teal-500 focus:border-transparent outline-none" placeholder="Acme Imports LLC (required)">
            </div>
          </div>
          <button id="scan-btn" onclick="startScan()" class="mt-8 w-full py-4 px-8 bg-teal-600 hover:bg-teal-700 text-white font-bold text-lg rounded-xl shadow-lg transition disabled:opacity-50 disabled:cursor-not-allowed" disabled>
            Run Free Compliance Scan
          </button>
          <p class="mt-6 text-center text-sm text-gray-500 dark:text-gray-400">
            By scanning, you agree to our <a href="/terms" class="text-teal-600 dark:text-teal-400 hover:underline">Terms</a> and <a href="/privacy" class="text-teal-600 dark:text-teal-400 hover:underline">Privacy Policy</a>. This is not legal advice — verify with a licensed customs broker.
          </p>
          </div>
        </div>
        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-md border border-gray-200 dark:border-gray-700 text-center">
            <div class="text-5xl mb-4">🏷️</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">HS Code Classification</h3>
            <p class="text-gray-600 dark:text-gray-400">6-digit + 10-digit codes with confidence score</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-md border border-gray-200 dark:border-gray-700 text-center">
            <div class="text-5xl mb-4">💰</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Duty Rate Breakdown</h3>
            <p class="text-gray-600 dark:text-gray-400">Base + Section 301/232 stacked tariffs</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-md border border-gray-200 dark:border-gray-700 text-center">
            <div class="text-5xl mb-4">��️</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Sanctions Screening</h3>
            <p class="text-gray-600 dark:text-gray-400">Real-time OFAC, EU, UN list checks</p>
          </div>
          <div class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-md border border-gray-200 dark:border-gray-700 text-center">
            <div class="text-5xl mb-4">📋</div>
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Action Plan</h3>
            <p class="text-gray-600 dark:text-gray-400">Plain-English steps: fix, file, hold</p>
          </div>
        </div>
      </div>
      <div id="screen-scan" class="hidden flex flex-col items-center justify-center min-h-[60vh] space-y-8">
        <div class="relative w-28 h-28 mb-8 pulse-shield">
          <div class="absolute inset-0 rounded-full bg-teal-400/20 animate-ping"></div>
          <div class="absolute inset-3 rounded-full bg-teal-500/30 animate-pulse"></div>
          <div class="absolute inset-0 flex items-center justify-center text-5xl">🛡️</div>
        </div>
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white">Analyzing your document…</h2>
        <div class="w-96 bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
          <div id="scan-progress" class="bg-teal-600 h-2 rounded-full w-0 transition-all duration-300"></div>
        </div>
        <div id='step-1' class='flex items-center gap-3 text-gray-700 dark:text-gray-200'><span class='text-teal-500 font-bold'>✓</span> 📄 Parsing document</div>
        <div id='step-2' class='flex items-center gap-3 text-gray-400'><span>○</span> 🏷️ Classifying HS codes</div>
        <div id='step-3' class='flex items-center gap-3 text-gray-400'><span>○</span> 🛡️ Screening sanctions lists</div>
        <div id='step-4' class='flex items-center gap-3 text-gray-400'><span>○</span> 💰 Calculating tariff exposure</div>
        <div id='step-5' class='flex items-center gap-3 text-gray-400'><span>○</span> 📋 Building action plan</div>
        <p class="text-gray-600 dark:text-gray-400">Usually completes in 30–45 seconds</p>
      </div>
<div id="screen-result" class="hidden">
  <div class="bg-[#0b1e3d] text-white py-10 px-6">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row gap-8 items-start">
      <div class="flex-1">
        <span class="inline-block bg-teal-500/20 text-teal-300 border border-teal-500/30 text-xs font-bold tracking-widest px-4 py-1 rounded-full mb-4">AUDIT COMPLETE</span>
        <h2 class="text-4xl font-black leading-tight mb-2">Your <span id="res-icon">⚠️</span> <em id="res-verdict" class="not-italic text-yellow-400">Needs Review</em></h2>
        <p id="res-meta" class="text-white/40 font-mono text-xs tracking-wide mb-3"></p>
        <p id="res-summary" class="text-gray-300 text-base leading-relaxed"></p>
      </div>
      <div class="bg-white/10 border border-white/20 rounded-2xl p-6 text-center min-w-[140px]">
        <div id="res-score-num" class="text-5xl font-black text-yellow-400">0</div>
        <div class="text-xs font-bold tracking-widest text-white/40 mt-1">RISK SCORE</div>
        <div id="res-score-label" class="mt-2 bg-white/10 text-white text-xs font-bold px-3 py-1 rounded-full">REVIEW</div>
      </div>
    </div>
  </div>

  <div class="bg-[#0d2347] border-t border-white/10 sticky top-0 z-30">
    <div class="flex flex-wrap gap-1 p-2 w-full justify-center max-w-5xl mx-auto">
      <button onclick="switchTab('products')" id="tab-btn-products" class="tab-btn tab-active flex-shrink-0 px-5 py-4 text-sm font-semibold border-b-2 border-transparent transition-all text-white">📦 Products</button>
      <button onclick="switchTab('problems')" id="tab-btn-problems" class="tab-btn flex-shrink-0 px-5 py-4 text-sm font-semibold text-white/50 border-b-2 border-transparent hover:text-white transition-all">🔴 Problems Found</button>
      <button onclick="switchTab('sanctions')" id="tab-btn-sanctions" class="tab-btn flex-shrink-0 px-5 py-4 text-sm font-semibold text-white/50 border-b-2 border-transparent hover:text-white transition-all">🛡️ Sanctions</button>
      <button onclick="switchTab('tariffs')" id="tab-btn-tariffs" class="tab-btn flex-shrink-0 px-5 py-4 text-sm font-semibold text-white/50 border-b-2 border-transparent hover:text-white transition-all">💰 Tariffs</button>
      <button onclick="switchTab('action')" id="tab-btn-action" class="tab-btn flex-shrink-0 px-5 py-4 text-sm font-semibold text-white/50 border-b-2 border-transparent hover:text-white transition-all">⚡ Fix It</button>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-10 space-y-6">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-total" class="text-3xl font-black text-gray-900 dark:text-white">0</div><div class="text-xs text-gray-500 mt-1">Total Scanned</div></div>
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-cleared" class="text-3xl font-black text-green-600">0</div><div class="text-xs text-gray-500 mt-1">✅ Cleared</div></div>
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-review" class="text-3xl font-black text-yellow-500">0</div><div class="text-xs text-gray-500 mt-1">⚠️ Review</div></div>
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-flagged" class="text-3xl font-black text-red-600">0</div><div class="text-xs text-gray-500 mt-1">🚨 Flagged</div></div>
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-score" class="text-3xl font-black text-gray-900 dark:text-white">0/100</div><div class="text-xs text-gray-500 mt-1">Risk Score</div></div>
    </div>

    <div id="res-alert" class="hidden rounded-xl p-4 flex gap-3 items-start text-base font-medium"></div>

    <div id="tab-products" class="tab-panel space-y-4"></div>

    <div id="tab-problems" class="tab-panel hidden space-y-4">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 p-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">What's Wrong — and How to Fix It</h3>
        <p class="text-gray-500 text-sm mb-6">Plain-English breakdown of every compliance issue found.</p>
        <div id="doc-visual-wrap" class="hidden mb-6">
          <h4 class="text-base font-bold text-gray-700 dark:text-gray-300 mb-3">🔍 Your Document — Problem Areas</h4>
          <div class="doc-container rounded-xl overflow-hidden border border-gray-200 dark:border-gray-700">
            <img id="doc-visual-img" src="" class="w-full object-contain rounded-xl">
            <div id="doc-markers"></div>
          </div>
          <div id="doc-legend" class="flex flex-wrap gap-3 mt-3"></div>
        </div>
        <div id="problems-list" class="space-y-4"></div>
        <div id="problems-positives-wrap" class="hidden mt-4 bg-green-50 dark:bg-green-950/30 border-l-4 border-green-500 rounded-xl p-5">
          <div class="font-bold text-green-700 dark:text-green-400 mb-2">✅ What you did right</div>
          <div id="problems-positives" class="text-sm text-green-800 dark:text-green-300 leading-relaxed"></div>
        </div>
      </div>
    </div>

    <div id="tab-sanctions" class="tab-panel hidden">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 p-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">🛡️ Sanctions Screening Results</h3>
        <div id="sanctions-content" class="space-y-3 text-base leading-relaxed"></div>
      </div>
    </div>

    <div id="tab-tariffs" class="tab-panel hidden">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 p-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">💰 Tariff Exposure Breakdown</h3>
        <div id="tariffs-content" class="space-y-3"></div>
      </div>
    </div>

    <div id="tab-action" class="tab-panel hidden space-y-4">
      <h3 class="text-2xl font-black text-teal-600 dark:text-teal-400">⚡ Your Step-by-Step Fix Plan</h3>
      <div id="action-holds" class="space-y-4"></div>
      <div id="action-reviews" class="space-y-4"></div>
      <div id="action-approves" class="space-y-4"></div>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 p-6 mt-2">
        <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-4">📋 2026 Compliance Checklist</h4>
        <div id="checklist-box" class="space-y-3 text-base"></div>
      </div>
      <div id="pdf-download-box" class="bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800 rounded-2xl p-6 text-center">
        <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2">📄 Download Your Compliance Report</h4>
        <p class="text-gray-500 text-sm mb-4">Full PDF with HS codes, sanctions results, tariff breakdown, and action steps.</p>
        <button onclick="downloadPDF()" class="bg-teal-600 hover:bg-teal-700 text-white font-bold px-8 py-3 rounded-xl transition text-base">⬇ Download PDF Report</button>
      </div>
    </div>

    <div class="bg-gradient-to-br from-[#0b1e3d] to-[#0a3d62] rounded-2xl p-8 text-center text-white">
      <h3 class="text-2xl font-black mb-2">Need a Deeper Audit?</h3>
      <p class="text-gray-300 text-sm mb-6">Pro plan: unlimited scans, real-time tariff alerts, full OFAC+UN+EU screening, clean PDF reports.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/pricing" class="bg-teal-500 hover:bg-teal-400 text-white font-bold px-8 py-3 rounded-xl transition">Upgrade to Pro — $299/mo</a>
        <button onclick="rescan()" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold px-8 py-3 rounded-xl transition">🔄 Scan Another Document</button>
      </div>
    </div>
  </div>
</div>
<div id='screen-error' class='hidden max-w-2xl mx-auto px-6 py-20 text-center'>
  <div class='text-6xl mb-6'>⚠️</div>
  <h2 class='text-2xl font-black text-gray-900 dark:text-white mb-4'>Scan Failed</h2>
  <p id='error-msg' class='text-gray-500 text-lg mb-8'>Something went wrong. Please try again.</p>
  <button onclick='rescan()' class='px-8 py-4 bg-teal-600 hover:bg-teal-700 text-white font-bold rounded-xl transition'>Try Again</button>
</div>
    </div>
  </section>

  <!-- Internal Links: related pages -->
  <section class="py-16 bg-[#f7f5f0] border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-6">
      <h2 class="text-2xl font-black text-gray-900 mb-8 text-center">Explore More TradeShield AI</h2>
      <div class="grid sm:grid-cols-3 gap-6">
        <a href="/pricing" class="group flex flex-col bg-white border border-gray-200 hover:border-[#0a7c6e] rounded-xl p-6 transition-all hover:shadow-md">
          <span class="text-2xl mb-3">💼</span>
          <h3 class="font-bold text-gray-900 mb-2 group-hover:text-[#0a7c6e] transition-colors">Upgrade Your Plan</h3>
          <p class="text-sm text-gray-600 flex-1">Unlock 500+ scans/month, bulk uploads, and priority support. Professional plans start at $249/mo.</p>
          <span class="mt-4 text-[#0a7c6e] font-bold text-sm">View Pricing →</span>
        </a>
        <a href="/blog" class="group flex flex-col bg-white border border-gray-200 hover:border-[#0a7c6e] rounded-xl p-6 transition-all hover:shadow-md">
          <span class="text-2xl mb-3">📰</span>
          <h3 class="font-bold text-gray-900 mb-2 group-hover:text-[#0a7c6e] transition-colors">Trade Compliance Blog</h3>
          <p class="text-sm text-gray-600 flex-1">Stay current on tariff changes, OFAC sanctions updates, HS code best practices, and supply chain risk.</p>
          <span class="mt-4 text-[#0a7c6e] font-bold text-sm">Read Articles →</span>
        </a>
        <a href="/about" class="group flex flex-col bg-white border border-gray-200 hover:border-[#0a7c6e] rounded-xl p-6 transition-all hover:shadow-md">
          <span class="text-2xl mb-3">🏢</span>
          <h3 class="font-bold text-gray-900 mb-2 group-hover:text-[#0a7c6e] transition-colors">About TradeShield AI</h3>
          <p class="text-sm text-gray-600 flex-1">Learn about our Los Angeles-based team, our Google Cloud infrastructure, and our compliance mission.</p>
          <span class="mt-4 text-[#0a7c6e] font-bold text-sm">Our Story →</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
<script is:inline>
(function(){
  if(window._fbInit)return;
  window._fbInit=true;
  if(!firebase.apps.length){
    firebase.initializeApp({
      apiKey:'AIzaSyCII6BiECYWnVDLAa8GmvaXUhJfIlIi10o',
      authDomain:'itcloudx.com',
      projectId:'itcloudx-com',
      storageBucket:'itcloudx-com.firebasestorage.app',
      messagingSenderId:'836345929499',
      appId:'1:836345929499:web:620dbc288ee74e45633dbe'
    });
  }
  window.currentUserEmail=null;
  window.currentUserToken=null;

  function updateUI(user){
    var sb=document.getElementById('google-signin-btn');
    var su=document.getElementById('signed-in-user');
    var ss=document.getElementById('scan-form-section');
    var ud=document.getElementById('user-email-display');
    if(user){
      window.currentUserEmail=user.email;
      user.getIdToken(true).then(function(t){
        window.currentUserToken=t;
        localStorage.setItem('ts_auth_token',t);
        localStorage.setItem('ts_auth_email',user.email);
        localStorage.setItem('ts_auth_name',user.displayName||user.email);
      });
      if(sb)sb.style.display='none';
      if(su)su.style.display='flex';
      if(ss)ss.style.display='block';
      if(ud)ud.textContent=user.displayName||user.email;
    } else {
      if(!localStorage.getItem('ts_auth_email')){
        window.currentUserEmail=null;
        window.currentUserToken=null;
        if(sb)sb.style.display='flex';
        if(su)su.style.display='none';
        if(ss)ss.style.display='none';
      }
    }
  }
  window.updateUI=updateUI;

  function restoreCachedUI(){
    var cachedEmail=localStorage.getItem('ts_auth_email');
    if(cachedEmail){
      var sb=document.getElementById('google-signin-btn');
      var su=document.getElementById('signed-in-user');
      var ss=document.getElementById('scan-form-section');
      var ud=document.getElementById('user-email-display');
      if(sb)sb.style.display='none';
      if(su)su.style.display='flex';
      if(ss)ss.style.display='block';
      if(ud)ud.textContent=localStorage.getItem('ts_auth_name')||cachedEmail;
      window.currentUserEmail=cachedEmail;
      window.currentUserToken=localStorage.getItem('ts_auth_token');
    }
  }

  function initAuthUI(){
    restoreCachedUI();
    firebase.auth().onAuthStateChanged(function(user){
      if(user){
        window.currentUserEmail=user.email;
        window.currentUserToken=localStorage.getItem('ts_auth_token');
        var sb=document.getElementById('google-signin-btn');
        var su=document.getElementById('signed-in-user');
        var ss=document.getElementById('scan-form-section');
        var ud=document.getElementById('user-email-display');
        if(sb)sb.style.display='none';
        if(su)su.style.display='flex';
        if(ss)ss.style.display='block';
        if(ud)ud.textContent=user.displayName||user.email;
      }
    });
  }

  window.signInWithGoogle=function(){
    var provider=new firebase.auth.GoogleAuthProvider();
    provider.setCustomParameters({prompt:'select_account'});
    firebase.auth().signInWithPopup(provider).then(function(result){
      var user=result.user;
      window.currentUserEmail=user.email;
      user.getIdToken(true).then(function(t){
        window.currentUserToken=t;
        localStorage.setItem('ts_auth_token',t);
        localStorage.setItem('ts_auth_email',user.email);
        localStorage.setItem('ts_auth_name',user.displayName||user.email);
      });
      var sb=document.getElementById('google-signin-btn');
      var su=document.getElementById('signed-in-user');
      var ss=document.getElementById('scan-form-section');
      var ud=document.getElementById('user-email-display');
      if(sb)sb.style.display='none';
      if(su)su.style.display='flex';
      if(ss)ss.style.display='block';
      if(ud)ud.textContent=user.displayName||user.email;
    }).catch(function(e){
      console.error('Auth error:',e.code,e.message);
      alert('Sign-in failed ('+e.code+'): '+e.message);
    });
  };

  window.signOut=function(){
    localStorage.removeItem('ts_auth_token');
    localStorage.removeItem('ts_auth_email');
    localStorage.removeItem('ts_auth_name');
    window.currentUserEmail=null;
    window.currentUserToken=null;
    firebase.auth().signOut().then(function(){
      var sb=document.getElementById('google-signin-btn');
      var su=document.getElementById('signed-in-user');
      var ss=document.getElementById('scan-form-section');
      if(sb)sb.style.display='flex';
      if(su)su.style.display='none';
      if(ss)ss.style.display='none';
    });
  };

  document.addEventListener('DOMContentLoaded',initAuthUI);
  document.addEventListener('astro:page-load',initAuthUI);
  document.addEventListener('astro:after-swap',restoreCachedUI);
})();
</script>
<script is:inline>
const FUNCTION_URL='https://trade-vision-scan-tmv6tfm3wa-uc.a.run.app';
const MIN_SCAN_MS=12000;
let selectedFile=null,previewDataURL=null,lastResult=null;

function handleDragOver(e){e.preventDefault();e.currentTarget.classList.add('border-teal-500','bg-teal-50/50');}
function handleDrop(e){e.preventDefault();e.currentTarget.classList.remove('border-teal-500','bg-teal-50/50');if(e.dataTransfer.files.length)setFile(e.dataTransfer.files[0]);}
function handleFileSelect(e){if(e.target.files[0])setFile(e.target.files[0]);}
function setFile(file){
