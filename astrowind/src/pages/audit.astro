  document.getElementById('scan-btn').disabled=false;
  if(file.type.startsWith('image/')){const r=new FileReader();r.onload=e=>{previewDataURL=e.target.result;const pi=document.getElementById('preview-img-upload');const dp=document.getElementById('doc-preview-upload');if(pi)pi.src=previewDataURL;if(dp)dp.classList.remove('hidden');};r.readAsDataURL(file);}
}
function clearFile(){
  selectedFile=null;previewDataURL=null;
  document.getElementById('file-input').value='';
  document.getElementById('drop-idle').classList.remove('hidden');
  document.getElementById('drop-ready').classList.add('hidden');
  const dp2=document.getElementById('doc-preview-upload');if(dp2)dp2.classList.add('hidden');
  document.getElementById('scan-btn').disabled=true;
}
function startScan(){
  const company=document.getElementById('company').value.trim();
  if(!company){alert('Please enter your company name.');return;}
  const email = window.currentUserEmail || '';
  if(!selectedFile){alert('Please select a file.');return;}
  lastResult=null;
  document.getElementById('res-score-num').textContent='—';
  document.getElementById('res-meta').innerHTML='';
  document.getElementById('res-summary').textContent='';
  show('screen-scan');hide('screen-upload');
  const scanEl=document.getElementById('screen-scan');
  const rect=scanEl.getBoundingClientRect();const absoluteTop=rect.top+window.pageYOffset;window.scrollTo({top:absoluteTop-80,behavior:'smooth'});
  [1,2,3,4,5].forEach((s,i)=>setTimeout(()=>{
    const el=document.getElementById('step-'+s);
    if(!el)return;
    el.querySelector('span').textContent='✓';
    el.classList.remove('text-gray-400');el.classList.add('text-gray-700','dark:text-gray-200');
    document.getElementById('scan-progress').style.width=((i+1)/5*85)+'%';
  },i*2400));
  const fd=new FormData();
  fd.append('file',selectedFile);
  fd.append('company',company);
  fd.append('email', email);
  const fetchPromise=fetch(FUNCTION_URL,{method:'POST',body:fd}).then(r=>{if(r.status===429)throw new Error('429 limit reached');return r.json();}).then(d=>{if(d.error&&d.error.includes('limit'))throw new Error('429 limit reached');return d;});
  const timerPromise=new Promise(resolve=>setTimeout(resolve,12000));
  Promise.all([fetchPromise,timerPromise])
    .then(([data])=>{
      document.getElementById('scan-progress').style.width='100%';
      lastResult=data;
      requestAnimationFrame(()=>renderResults(data));
    })
    .catch(err=>{hide('screen-scan');const em=document.getElementById('error-msg');if(em){const msg=err.message||'';em.innerHTML=msg.includes('429')||msg.includes('limit')?'<div style="text-align:center;padding:16px 0"><div style="font-size:48px;margin-bottom:12px">🚫</div><div style="font-size:22px;font-weight:900;color:#ef4444;margin-bottom:8px;letter-spacing:-0.5px">FREE SCAN LIMIT REACHED</div><div style="font-size:15px;color:#64748b;margin-bottom:16px">You have used all 5 free scans this month.</div><div style="font-size:13px;color:#0a7c6e;font-weight:700;margin-bottom:16px">🛡️ SCANNED BY SHERLOCK VISION API</div><a href="/pricing" style="display:inline-block;background:#0a7c6e;color:white;font-weight:800;font-size:16px;padding:14px 32px;border-radius:12px;text-decoration:none">⚡ Upgrade to Pro — $299/mo</a><div style="font-size:12px;color:#94a3b8;margin-top:10px">Unlimited scans · Full OFAC+UN+EU · Clean PDF reports</div></div>':msg||'Network error. Please try again.';}show('screen-error');});
}
function riskColor(r){return r==='HIGH'?'#ef4444':r==='MEDIUM'?'#f59e0b':'#22c55e';}
function riskIcon(r){return r==='HIGH'?'🚨':r==='MEDIUM'?'⚠️':'✅';}
function riskBadge(r){
  const cls=r==='HIGH'?'bg-red-100 text-red-700':'bg-yellow-100 text-yellow-700';
  return r==='LOW'?'<span class="inline-block px-3 py-1 rounded-full text-xs font-bold bg-green-100 text-green-700">✅ LOW</span>':`<span class="inline-block px-3 py-1 rounded-full text-xs font-bold ${cls}">${riskIcon(r)} ${r}</span>`;
}
function renderResults(data){
  hide('screen-scan');
  show('screen-result');
  void document.getElementById('screen-result').offsetHeight;
  const SR=document.getElementById('screen-result');
  const products=data.products||[];
