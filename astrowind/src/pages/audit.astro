  SR.querySelector('#res-summary').textContent=ship.summary||data.summary||'';
  SR.querySelector('#res-meta').innerHTML='JOB: '+(data.job_id||data.jobId||'—')+' — COMPANY: '+(data.company_name||data.company||document.getElementById('company')?.value||'—')+' — '+new Date().toDateString().toUpperCase()+'<br/><span class="text-teal-400 font-bold tracking-widest mt-2 inline-block">🛡️ SCANNED BY SHERLOCK VISION API</span>';
  let cleared=0,review=0,flagged=0;
  products.forEach(p=>{const r=(p.risk_level||'').toUpperCase();if(r==='LOW')cleared++;else if(r==='HIGH')flagged++;else review++;});
  SR.querySelector('#stat-total').textContent=products.length;
  SR.querySelector('#stat-cleared').textContent=cleared;
  SR.querySelector('#stat-review').textContent=review;
  SR.querySelector('#stat-flagged').textContent=flagged;
  SR.querySelector('#stat-score').textContent=score+'/100';
  if(flagged>0){const al=SR.querySelector('#res-alert');al.className='rounded-xl p-4 flex gap-3 items-start text-base font-medium bg-red-50 dark:bg-red-950/30 border border-red-200 text-red-800';al.innerHTML='<span class="text-xl">🚨</span><div><strong>Shipment Hold Recommended.</strong> '+flagged+' product'+(flagged!==1?'s':'')+' flagged as HIGH risk. Review "Problems Found" and "Fix It" tabs.</div>';al.classList.remove('hidden');}
  renderProducts(products,data);renderProblems(products,data);renderSanctions(products,data);renderTariffs(products);renderFixIt(products);renderChecklist(products);
  if(previewDataURL){const vi=SR.querySelector('#doc-visual-img');const vw=SR.querySelector('#doc-visual-wrap');if(vi&&vw){vi.src=previewDataURL;vw.classList.remove('hidden');renderMarkers(products);}}
}
function renderProducts(products,data){
  const el=document.getElementById('screen-result').querySelector('#tab-products');
  if(!products.length){el.innerHTML='<p class="text-gray-500">No products extracted.</p>';return;}
  el.innerHTML=products.map((p,i)=>{
    const r=(p.risk_level||'LOW').toUpperCase();
    return '<div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 overflow-hidden slide-up" style="animation-delay:'+(i*0.08)+'s">'+
      '<div class="p-5 flex gap-4 items-start cursor-pointer" onclick="toggleProd('+i+')">'+
        '<div class="flex-1"><div class="flex flex-wrap gap-2 items-center mb-2">'+riskBadge(r)+'<span class="font-bold text-gray-900 dark:text-white text-base">'+p.name+'</span></div>'+
        '<div class="flex flex-wrap gap-4 text-sm text-gray-500"><span>HS <strong class="text-gray-800 dark:text-gray-200">'+(p.hs_code||'—')+'</strong></span><span>Duty <strong class="text-gray-800 dark:text-gray-200">'+(p.duty_rate||'—')+'</strong></span><span>Risk <strong style="color:'+riskColor(r)+'">'+(p.risk_score||0)+'/100</strong></span></div></div>'+
        '<span class="text-gray-400 text-sm mt-1" id="prod-chevron-'+i+'">'+(i===0?'▲':'▼')+'</span>'+
