        '<div class="grid grid-cols-2 md:grid-cols-4 gap-3">'+
          '<div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3"><div class="text-xs text-gray-400 mb-1">HS Code</div><div class="font-bold text-gray-900 dark:text-white">'+(p.hs_code||'—')+'</div></div>'+
          '<div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3"><div class="text-xs text-gray-400 mb-1">Base Duty</div><div class="font-bold">'+(p.duty_rate||'—')+'</div></div>'+
          '<div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3"><div class="text-xs text-gray-400 mb-1">Tariff Layers</div><div class="font-bold">'+(p.tariff_layers||'—')+'</div></div>'+
