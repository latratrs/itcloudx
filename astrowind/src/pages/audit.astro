  const verdictText=rec.includes('HOLD')?'HOLD — Action Required':rec==='APPROVE'?'Cleared ✓':'Needs Review';
  const verdictCls=score>=67?'text-red-400':score>=34?'text-yellow-400':'text-green-400';
  SR.querySelector('#res-score-num').textContent=score;
