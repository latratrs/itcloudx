---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';
import { findLatestPosts } from '~/utils/blog';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'TradeShield AI — One Scan. Total Trade Shield. No Fines, Before They Start.',
  description: 'AI scans invoices for correct HS codes, current tariffs, OFAC/EU/UN sanctions. Free 5 scans, full compliance report in 60 seconds. Avoid $1M+ fines.',
  ignoreTitleTemplate: true,
};

const latestPosts = await findLatestPosts({ count: 3 }).catch(() => []);

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'TradeShield AI',
  url: 'https://itcloudx.com',
  logo: 'https://itcloudx.com/favicon.svg',
  description: 'AI-powered US customs & trade compliance SaaS. One Scan. Total Shield. No Fines. Real Trade Defense System.',
  foundingLocation: { '@type': 'Place', name: 'Los Angeles, CA' },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'customer support',
    email: 'yaltshul@itcloudx.com',
  },
  sameAs: [],
};
---

<Layout metadata={metadata}>
<style>
  @keyframes slideUp { from { opacity:0; transform:translateY(24px); } to { opacity:1; transform:translateY(0); } }
  @keyframes pulseShield { 0%,100% { transform:scale(1); } 50% { transform:scale(1.08); } }
  .slide-up { animation: slideUp 0.5s ease-out forwards; }
  .pulse-shield { animation: pulseShield 2s ease-in-out infinite; }
  .tab-active { background:#0fb39d !important; color:white !important; }
  .doc-container { position:relative; display:block; width:100%; }
  .doc-marker { position:absolute; border:3px solid #ef4444; background:rgba(239,68,68,0.1); border-radius:4px; z-index:10; }
  .doc-marker-label { position:absolute; top:4px; left:4px; background:#ef4444; color:white; font-size:11px; font-weight:700; padding:2px 8px; border-radius:4px; max-width:90%; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
</style>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="relative bg-[#030a14] overflow-hidden">
    <div class="absolute inset-0 opacity-10"
      style="background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 40px 40px;">
    </div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full opacity-20 pointer-events-none"
      style="background: radial-gradient(ellipse, #0a7c6e 0%, transparent 70%);">
    </div>


    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-14 md:pt-24 md:pb-20">

      <div class="flex justify-center mb-6"><span class="inline-flex items-center gap-2 border border-[#f0a820]/40 text-[#f0a820] text-[11px] font-black uppercase tracking-widest px-5 py-2 rounded-full"><span class="w-2 h-2 rounded-full bg-[#f0a820] animate-pulse inline-block"></span>Live Tariff &amp; Sanctions Intelligence · Continuously Updated</span></div>
      <h1 class="text-center text-4xl md:text-6xl lg:text-7xl font-black leading-tight tracking-tight text-white mb-4">
        One Scan. Total Trade Shield.<br>
        <span style="color:#0fb39d">No Fines, Before They Start.</span>
      </h1>

      <p class="text-center text-lg md:text-xl text-white/70 max-w-3xl mx-auto mb-3">
        TradeShield AI delivers accurate HS codes, duty rates, sanctions flags and a full PDF report in <strong class="text-white">60 seconds.</strong>
      </p>
      <p class="text-center text-sm text-white/40 mb-10">Free for first 5 scans · No credit card · Powered by TradeShield AI on Google Cloud</p>

      <!-- ═══ UPLOAD WIDGET — Silent Data Bridge ═══ -->
      <div class="max-w-3xl mx-auto rounded-3xl mb-8" id="scan-widget">
<div id="screen-upload">
  <div class="bg-gradient-to-br from-[#0b1e3d] to-[#0a3d62] text-white py-16 px-6">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row items-center gap-10">
      <div class="flex-1">
        <span class="inline-block bg-teal-500/20 text-teal-300 border border-teal-500/30 text-xs font-bold tracking-widest px-4 py-1 rounded-full mb-4">FREE COMPLIANCE AUDIT</span>
        <h1 class="text-4xl md:text-5xl font-black leading-tight mb-4">Stop Customs Fines <em class="text-teal-400 not-italic">Before They Start</em></h1>
        <p class="text-gray-300 text-lg leading-relaxed mb-6">Upload any shipping document — PDF, CSV, Excel, or photo. Get instant AI analysis: HS codes, duty rates, sanctions screening, and a plain-English action plan.</p>
        <div class="flex flex-wrap gap-3">
          <span class="bg-white/10 border border-white/20 text-white/80 text-sm px-4 py-1.5 rounded-full">🛡️ OFAC · UN · EU Screened</span>
          <span class="bg-white/10 border border-white/20 text-white/80 text-sm px-4 py-1.5 rounded-full">⚡ Results in ~60 seconds</span>
          <span class="bg-white/10 border border-white/20 text-white/80 text-sm px-4 py-1.5 rounded-full">🔒 No data stored</span>
        </div>
      </div>
      <div class="bg-white/10 border border-white/20 rounded-2xl p-8 text-center min-w-[160px]">
        <div class="text-5xl font-black text-teal-400">FREE</div>
        <div class="text-xs font-bold tracking-widest text-white/50 mt-1">5 SCANS/MONTH</div>
        <div class="mt-3 bg-white/10 text-white text-xs font-bold px-4 py-1.5 rounded-full">No credit card</div>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-6 py-12">
    <div class="bg-white dark:bg-gray-800 rounded-3xl shadow-xl border border-gray-200 dark:border-gray-700 p-8">
      <div id='google-signin-btn' style='text-align:center;padding:32px 24px;display:flex;flex-direction:column;align-items:center;gap:16px'>
        <div style='font-size:48px'>🔐</div>
        <h3 style='font-size:18px;font-weight:800;color:#0b1e3d;margin:0'>Sign in to start your free scan</h3>
        <p style='font-size:13px;color:#64748b;margin:0'>5 free scans per month · No credit card required</p>
        <button onclick='if(typeof firebase==="undefined"){alert("Auth loading, please try again");return;}window.signInWithGoogle();' style='display:flex;align-items:center;gap:10px;background:white;border:2px solid #e2e8f0;border-radius:12px;padding:12px 24px;font-size:14px;font-weight:700;color:#0b1e3d;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.08)'>
          <svg width=20 height=20 viewBox='0 0 48 48'><path fill='#EA4335' d='M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z'/><path fill='#4285F4' d='M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z'/><path fill='#FBBC05' d='M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z'/><path fill='#34A853' d='M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.18 1.48-4.97 2.31-8.16 2.31-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z'/></svg>
          Continue with Google
        </button>
      </div>
      <div id='signed-in-user' style='display:none;align-items:center;justify-content:space-between;padding:10px 16px;background:#f0fdf4;border:1px solid #86efac;border-radius:12px;margin-bottom:16px'>
        <span style='font-size:13px;color:#166534;font-weight:600'>✅ Signed in as <span id='user-email-display'></span></span>
        <button onclick='signOut()' style='font-size:11px;color:#64748b;background:none;border:none;cursor:pointer;text-decoration:underline'>Sign out</button>
      </div>
      <div id='scan-form-section' style='display:none'>
      <div id="drop-zone" class="border-2 border-dashed border-gray-300 dark:border-gray-600 rounded-2xl p-10 text-center cursor-pointer hover:border-teal-500 hover:bg-teal-50/50 dark:hover:bg-teal-950/20 transition-all"
        ondrop="handleDrop(event)" ondragover="handleDragOver(event)" onclick="document.getElementById('file-input').click()">
        <input type="file" id="file-input" accept=".pdf,.csv,.xlsx,.xls,.doc,.docx,.rtf,.ods,.html,.htm,.jpg,.jpeg,.png,.gif,.tiff,.tif,.webp" class="hidden" onchange="handleFileSelect(event)">
        <div id="drop-idle">
          <div class="text-5xl mb-4">📄</div>
          <div class="text-xl font-bold text-gray-800 dark:text-white mb-2">Drop your document here</div>
          <div class="text-gray-500 text-sm mb-4">PDF · CSV · Excel · JPG · PNG · TIFF</div>
          <p class='text-xs text-gray-400 mt-3 leading-relaxed'>✅ Best results: PDF invoices, Excel manifests, CSV product lists, JPG/PNG photos<br>⚠️ Limited support: RTF, HTML, GIF — may return lower confidence</p>
          <button type="button" class="bg-teal-600 hover:bg-teal-700 text-white font-bold px-6 py-2.5 rounded-xl transition">Choose File</button>
        </div>
        <div id="drop-ready" class="hidden">
          <div class="text-5xl mb-3">📎</div>
          <div id="drop-filename" class="text-lg font-bold text-gray-800 dark:text-white mb-1"></div>
          <div id="drop-filesize" class="text-gray-500 text-sm mb-3"></div>
          <div id="doc-preview-upload" class="mb-4 hidden"><img id="preview-img-upload" src="" alt="preview" class="max-h-48 rounded-xl border mx-auto object-contain"></div>
          <button type="button" onclick="clearFile()" class="text-red-500 hover:text-red-700 text-sm font-medium">✕ Remove file</button>
        </div>
      </div>
      <div class="mt-6 grid md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-semibold text-gray-700 dark:text-gray-300 mb-1.5">Company / Consignee Name <span style='color:#ef4444'>*</span></label>
          <input type="text" id="company" placeholder="Acme Imports LLC (required)" required class="w-full border border-gray-300 dark:border-gray-600 rounded-xl px-4 py-3 text-base bg-white dark:bg-gray-700 text-gray-900 dark:text-white focus:ring-2 focus:ring-teal-500 outline-none transition">
        </div>
      </div>
      <button id="scan-btn" type="button" onclick="startScan()" disabled class="mt-6 w-full py-4 text-lg font-black rounded-xl bg-gradient-to-r from-teal-600 to-teal-500 hover:from-teal-700 hover:to-teal-600 text-white shadow-lg transition disabled:opacity-40 disabled:cursor-not-allowed">
        🔍 Run Free Compliance Scan
      </button>
      <p class="mt-4 text-center text-xs text-gray-400 leading-relaxed">By scanning you agree to our <a href="/privacy" class="text-teal-600 hover:underline">Privacy Policy</a> & <a href="/terms" class="text-teal-600 hover:underline">Terms</a>. Files processed in memory, not stored. Not legal advice.</p>
      </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mt-8">
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow border border-gray-200 dark:border-gray-700 text-center" style="border-top:3px solid #0fb39d">
        <div class="text-3xl mb-2">🏷️</div><div class="font-bold text-gray-900 dark:text-white text-sm mb-1">HS Code Classification</div>
        <div class="text-xs text-gray-500 dark:text-gray-400">6-digit + 10-digit HTS codes with confidence score</div>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow border border-gray-200 dark:border-gray-700 text-center" style="border-top:3px solid #0fb39d">
        <div class="text-3xl mb-2">💰</div><div class="font-bold text-gray-900 dark:text-white text-sm mb-1">Duty Rate Breakdown</div>
        <div class="text-xs text-gray-500 dark:text-gray-400">Base + Section 301/232 stacked tariffs per item</div>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow border border-gray-200 dark:border-gray-700 text-center" style="border-top:3px solid #0fb39d">
        <div class="text-3xl mb-2">🛡️</div><div class="font-bold text-gray-900 dark:text-white text-sm mb-1">Sanctions Screening</div>
        <div class="text-xs text-gray-500 dark:text-gray-400">Real-time OFAC SDN, UN, EU list checks</div>
      </div>
      <div class="bg-white dark:bg-gray-800 rounded-2xl p-5 shadow border border-gray-200 dark:border-gray-700 text-center" style="border-top:3px solid #0fb39d">
        <div class="text-3xl mb-2">📋</div><div class="font-bold text-gray-900 dark:text-white text-sm mb-1">Action Plan</div>
        <div class="text-xs text-gray-500 dark:text-gray-400">Plain-English steps: fix, file, or hold</div>
      </div>
    </div>
  </div>
</div>

<div id="screen-scan" class="hidden min-h-screen flex flex-col items-center justify-center py-20 px-6 bg-gray-50 dark:bg-gray-900">
  <div class="relative w-28 h-28 mb-8 pulse-shield">
    <div class="absolute inset-0 rounded-full bg-teal-400/20 animate-ping"></div>
    <div class="absolute inset-3 rounded-full bg-teal-500/30 animate-pulse"></div>
    <div class="absolute inset-0 flex items-center justify-center text-5xl">🛡️</div>
  </div>
  <h2 class="text-3xl font-black text-gray-900 dark:text-white mb-6">Analyzing your document…</h2>
  <div class="space-y-3 mb-8 w-full max-w-sm">
    <div class="flex items-center gap-3 text-gray-700 dark:text-gray-200" id="step-1"><span class="text-teal-500 font-bold">✓</span> 📄 Parsing document</div>
    <div class="flex items-center gap-3 text-gray-400" id="step-2"><span>○</span> 🏷️ Classifying HS codes</div>
    <div class="flex items-center gap-3 text-gray-400" id="step-3"><span>○</span> 🛡️ Screening sanctions lists</div>
    <div class="flex items-center gap-3 text-gray-400" id="step-4"><span>○</span> 💰 Calculating tariff exposure</div>
    <div class="flex items-center gap-3 text-gray-400" id="step-5"><span>○</span> 📋 Building action plan</div>
  </div>
  <div class="w-80 bg-gray-200 dark:bg-gray-700 rounded-full h-2 overflow-hidden">
    <div id="scan-progress" class="bg-teal-500 h-2 rounded-full transition-all duration-500" style="width:5%"></div>
  </div>
  <p class="mt-3 text-sm text-gray-400 font-mono">Usually completes in 30–45 seconds</p>
</div>

<div id="screen-result" class="hidden">
  <div class="bg-[#0b1e3d] text-white py-10 px-6">
    <div class="max-w-5xl mx-auto flex flex-col md:flex-row gap-8 items-start">
      <div class="flex-1">
        <span class="inline-block bg-teal-500/20 text-teal-300 border border-teal-500/30 text-xs font-bold tracking-widest px-4 py-1 rounded-full mb-4">AUDIT COMPLETE</span>
        <h2 class="text-4xl font-black leading-tight mb-2">Your <span id="res-icon">⚠️</span> <em id="res-verdict" class="not-italic text-yellow-400">Needs Review</em></h2>
        <p id="res-meta" class="text-white/40 font-mono text-xs tracking-wide mb-3"></p>
        <p id="res-summary" class="text-gray-300 text-base leading-relaxed"></p>
      </div>
      <div class="bg-white/10 border border-white/20 rounded-2xl p-6 text-center min-w-[140px]">
        <div id="res-score-num" class="text-5xl font-black text-yellow-400">0</div>
        <div class="text-xs font-bold tracking-widest text-white/40 mt-1">RISK SCORE</div>
        <div id="res-score-label" class="mt-2 bg-white/10 text-white text-xs font-bold px-3 py-1 rounded-full">REVIEW</div>
      </div>
    </div>
  </div>

  <div class="bg-[#0d2347] border-t border-white/10 sticky top-0 z-30">
    <div class="flex flex-wrap gap-1 p-2 w-full justify-center max-w-5xl mx-auto">
      <button onclick="switchTab('products')" id="tab-btn-products" class="tab-btn tab-active flex-shrink-0 px-5 py-4 text-sm font-semibold border-b-2 border-transparent transition-all text-white">📦 Products</button>
      <button onclick="switchTab('problems')" id="tab-btn-problems" class="tab-btn flex-shrink-0 px-5 py-4 text-sm font-semibold text-white/50 border-b-2 border-transparent hover:text-white transition-all">🔴 Problems Found</button>
      <button onclick="switchTab('sanctions')" id="tab-btn-sanctions" class="tab-btn flex-shrink-0 px-5 py-4 text-sm font-semibold text-white/50 border-b-2 border-transparent hover:text-white transition-all">🛡️ Sanctions</button>
      <button onclick="switchTab('tariffs')" id="tab-btn-tariffs" class="tab-btn flex-shrink-0 px-5 py-4 text-sm font-semibold text-white/50 border-b-2 border-transparent hover:text-white transition-all">💰 Tariffs</button>
      <button onclick="switchTab('action')" id="tab-btn-action" class="tab-btn flex-shrink-0 px-5 py-4 text-sm font-semibold text-white/50 border-b-2 border-transparent hover:text-white transition-all">⚡ Fix It</button>
    </div>
  </div>

  <div class="max-w-5xl mx-auto px-6 py-10 space-y-6">
    <div class="grid grid-cols-2 md:grid-cols-5 gap-4">
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-total" class="text-3xl font-black text-gray-900 dark:text-white">0</div><div class="text-xs text-gray-500 mt-1">Total Scanned</div></div>
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-cleared" class="text-3xl font-black text-green-600">0</div><div class="text-xs text-gray-500 mt-1">✅ Cleared</div></div>
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-review" class="text-3xl font-black text-yellow-500">0</div><div class="text-xs text-gray-500 mt-1">⚠️ Review</div></div>
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-flagged" class="text-3xl font-black text-red-600">0</div><div class="text-xs text-gray-500 mt-1">🚨 Flagged</div></div>
      <div class="bg-white dark:bg-gray-800 rounded-xl p-4 text-center shadow border border-gray-100 dark:border-gray-700"><div id="stat-score" class="text-3xl font-black text-gray-900 dark:text-white">0/100</div><div class="text-xs text-gray-500 mt-1">Risk Score</div></div>
    </div>

    <div id="res-alert" class="hidden rounded-xl p-4 flex gap-3 items-start text-base font-medium"></div>

    <div id="tab-products" class="tab-panel space-y-4"></div>

    <div id="tab-problems" class="tab-panel hidden space-y-4">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 p-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-2">What's Wrong — and How to Fix It</h3>
        <p class="text-gray-500 text-sm mb-6">Plain-English breakdown of every compliance issue found.</p>
        <div id="doc-visual-wrap" class="hidden mb-6">
          <h4 class="text-base font-bold text-gray-700 dark:text-gray-300 mb-3">�� Your Document — Problem Areas</h4>
          <div class="doc-container rounded-xl overflow-hidden border border-gray-200 dark:border-gray-700">
            <img id="doc-visual-img" src="" class="w-full object-contain rounded-xl">
            <div id="doc-markers"></div>
          </div>
          <div id="doc-legend" class="flex flex-wrap gap-3 mt-3"></div>
        </div>
        <div id="problems-list" class="space-y-4"></div>
        <div id="problems-positives-wrap" class="hidden mt-4 bg-green-50 dark:bg-green-950/30 border-l-4 border-green-500 rounded-xl p-5">
          <div class="font-bold text-green-700 dark:text-green-400 mb-2">✅ What you did right</div>
          <div id="problems-positives" class="text-sm text-green-800 dark:text-green-300 leading-relaxed"></div>
        </div>
      </div>
    </div>

    <div id="tab-sanctions" class="tab-panel hidden">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 p-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">🛡️ Sanctions Screening Results</h3>
        <div id="sanctions-content" class="space-y-3 text-base leading-relaxed"></div>
      </div>
    </div>

    <div id="tab-tariffs" class="tab-panel hidden">
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 p-6">
        <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">💰 Tariff Exposure Breakdown</h3>
        <div id="tariffs-content" class="space-y-3"></div>
      </div>
    </div>

    <div id="tab-action" class="tab-panel hidden space-y-4">
      <h3 class="text-2xl font-black text-teal-600 dark:text-teal-400">⚡ Your Step-by-Step Fix Plan</h3>
      <div id="action-holds" class="space-y-4"></div>
      <div id="action-reviews" class="space-y-4"></div>
      <div id="action-approves" class="space-y-4"></div>
      <div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 p-6 mt-2">
        <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-4">📋 2026 Compliance Checklist</h4>
        <div id="checklist-box" class="space-y-3 text-base"></div>
      </div>
      <div id="pdf-download-box" class="bg-blue-50 dark:bg-blue-950/30 border border-blue-200 dark:border-blue-800 rounded-2xl p-6 text-center">
        <h4 class="text-lg font-bold text-gray-900 dark:text-white mb-2">📄 Download Your Compliance Report</h4>
        <p class="text-gray-500 text-sm mb-4">Full PDF with HS codes, sanctions results, tariff breakdown, and action steps.</p>
        <button onclick="downloadPDF()" class="bg-teal-600 hover:bg-teal-700 text-white font-bold px-8 py-3 rounded-xl transition text-base">⬇ Download PDF Report</button>
      </div>
    </div>

    <div class="bg-gradient-to-br from-[#0b1e3d] to-[#0a3d62] rounded-2xl p-8 text-center text-white">
      <h3 class="text-2xl font-black mb-2">Need a Deeper Audit?</h3>
      <p class="text-gray-300 text-sm mb-6">Pro plan: unlimited scans, real-time tariff alerts, full OFAC+UN+EU screening, clean PDF reports.</p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/pricing" class="bg-teal-500 hover:bg-teal-400 text-white font-bold px-8 py-3 rounded-xl transition">Upgrade to Pro — $299/mo</a>
        <button onclick="rescan()" class="bg-white/10 hover:bg-white/20 border border-white/20 text-white font-bold px-8 py-3 rounded-xl transition">🔄 Scan Another Document</button>
      </div>
