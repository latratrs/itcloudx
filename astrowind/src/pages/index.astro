          '<div class="bg-gray-50 dark:bg-gray-700 rounded-xl p-3"><div class="text-xs text-gray-400 mb-1">Sanctions</div><div class="font-bold">'+(p.sanctions_status||'—')+'</div></div>'+
        '</div>'+
        '<div class="rounded-xl p-4 border" style="background:'+(r==='HIGH'?'#fef2f2':r==='MEDIUM'?'#fffbeb':'#f0fdf4')+'">'+
          '<div class="font-bold mb-1" style="color:'+riskColor(r)+'">'+(p.recommended_action||'REVIEW')+'</div>'+
          '<div class="text-gray-700 dark:text-gray-300 leading-relaxed text-base">'+(p.compliance_notes||'—')+'</div>'+
        '</div>'+
      '</div></div>';
  }).join('');
}
function toggleProd(i){const d=document.getElementById('prod-detail-'+i);const c=document.getElementById('prod-chevron-'+i);const h=d.classList.toggle('hidden');c.textContent=h?'▼':'▲';}
function renderProblems(products,data){
  const el=document.getElementById('screen-result').querySelector('#problems-list');
  const highrisk=products.filter(p=>(p.risk_level||'').toUpperCase()!=='LOW');
  if(!highrisk.length){el.innerHTML='<div class="bg-green-50 border border-green-200 rounded-xl p-6 text-green-700 font-medium">✅ No compliance problems found.</div>';return;}
  el.innerHTML=highrisk.map((p,i)=>{
    const r=(p.risk_level||'MEDIUM').toUpperCase();
    const steps=Array.isArray(p.fix_steps)?p.fix_steps:(p.compliance_notes?[p.compliance_notes]:[]);
    return '<div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 overflow-hidden">'+
      '<div class="p-5" style="background:'+(r==='HIGH'?'#fef2f2':'#fffbeb')+'">'+
        '<div class="flex gap-3 items-start">'+
          '<span class="text-2xl mt-0.5">'+riskIcon(r)+'</span>'+
          '<div class="flex-1"><div class="font-bold text-lg text-gray-900 mb-1">'+'</div><div class="text-base text-gray-700 leading-relaxed">'+(p.compliance_notes||'Review required.')+'</div></div>'+
          riskBadge(r)+
        '</div></div>'+
      (steps.length?'<div class="p-5 border-t border-gray-100 dark:border-gray-700"><div class="text-xs font-bold font-mono tracking-widest text-teal-600 mb-3">🔧 HOW TO FIX THIS</div><div class="space-y-2">'+
        steps.map((s,n)=>'<div class="flex gap-3 text-base text-gray-700 dark:text-gray-300 py-2 border-b border-gray-100 last:border-0"><span class="text-teal-600 font-bold flex-shrink-0">'+
            (n+1)+'.</span><span>'+s+'</span></div>').join('')+
      '</div></div>':'')+
    '</div>';
  }).join('');
  const pos=data.shipment_summary?.positives||data.positives||'';
  if(pos){document.getElementById('screen-result').querySelector('#problems-positives').textContent=pos;document.getElementById('screen-result').querySelector('#problems-positives-wrap').classList.remove('hidden');}
}
function renderSanctions(products,data){
  const el=document.getElementById('screen-result').querySelector('#sanctions-content');
  el.innerHTML=products.map(p=>{
    const s=(p.sanctions_status||'').toUpperCase();
    const icon=s.includes('CLEAR')?'✅':s.includes('MATCH')?'🚨':'⚠️';
    const cls=s.includes('CLEAR')?'bg-green-50 border-green-200':'bg-red-50 border-red-200';
    return '<div class="'+cls+' border rounded-xl p-4 flex gap-3 items-start"><span class="text-xl">'+icon+'</span><div><div class="font-bold text-gray-900 dark:text-white">'+p.name+'</div><div class="text-gray-600 dark:text-gray-400 text-sm mt-1">'+(p.sanctions_notes||p.compliance_notes||'Screened against OFAC SDN, EU Consolidated, and UN lists.')+'</div></div></div>';
  }).join('')||'<p class="text-gray-500">No sanctions data.</p>';
}
function renderTariffs(products){
  document.getElementById('screen-result').querySelector('#tariffs-content').innerHTML=products.map(p=>
    '<div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-100 dark:border-gray-700 p-5"><div class="font-bold text-gray-900 dark:text-white mb-3">'+p.name+'</div>'+
    '<div class="grid grid-cols-2 md:grid-cols-3 gap-3 text-sm">'+
      '<div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-3"><div class="text-xs text-gray-400 mb-1">HS Code</div><div class="font-bold">'+(p.hs_code||'—')+'</div></div>'+
      '<div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-3"><div class="text-xs text-gray-400 mb-1">Base Duty</div><div class="font-bold">'+(p.duty_rate||'—')+'</div></div>'+
      '<div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-3"><div class="text-xs text-gray-400 mb-1">Tariff Layers</div><div class="font-bold">'+(p.tariff_layers||'—')+'</div></div>'+
    '</div></div>'
  ).join('')||'<p class="text-gray-500">No tariff data.</p>';
}
function renderFixIt(products){
  const byAction={HOLD:[],REVIEW:[],APPROVE:[]};
  products.forEach(p=>{const a=(p.recommended_action||'REVIEW').toUpperCase();if(a.includes('HOLD'))byAction.HOLD.push(p);else if(a.includes('APPROVE')||a.includes('CLEAR'))byAction.APPROVE.push(p);else byAction.REVIEW.push(p);});
  const rg=(items,color,icon,label)=>items.map(p=>
    '<div class="bg-white dark:bg-gray-800 rounded-2xl shadow border border-gray-100 dark:border-gray-700 overflow-hidden">'+
    '<div class="px-5 py-4" style="border-left:4px solid '+color+'"><div class="font-bold text-base mb-1" style="color:'+color+'">'+icon+' '+label+' — '+p.name+'</div>'+
    '<div class="text-base text-gray-600 dark:text-gray-300 leading-relaxed">'+(p.compliance_notes||'—')+'</div></div></div>'
  ).join('');
  document.getElementById('screen-result').querySelector('#action-holds').innerHTML=rg(byAction.HOLD,'#ef4444','🚨','HOLD');
  document.getElementById('screen-result').querySelector('#action-reviews').innerHTML=rg(byAction.REVIEW,'#f59e0b','⚠️','REVIEW');
  document.getElementById('screen-result').querySelector('#action-approves').innerHTML=rg(byAction.APPROVE,'#22c55e','✅','APPROVE');
}
function renderChecklist(products){
  const items=[[true,'HS codes classified using HTSUS 2026 schedule'],[true,'OFAC SDN sanctions screening completed'],[true,'EU & UN consolidated sanctions lists checked'],[products.every(p=>(p.risk_level||'').toUpperCase()!=='HIGH'),'No high-risk items detected'],[false,'Commercial invoice matches packing list (verify manually)']];
  document.getElementById('screen-result').querySelector('#checklist-box').innerHTML=items.map(([done,text])=>
    '<div class="flex gap-3 items-center text-base '+(done?'text-gray-800 dark:text-gray-200':'text-gray-400')+'"><span class="text-lg">'+(done?'✅':'⬜')+'</span><span>'+text+'</span></div>'
  ).join('');
}
function renderMarkers(products){
  const el=document.getElementById('screen-result')?.querySelector('#doc-markers');const legend=document.getElementById('screen-result')?.querySelector('#doc-legend');if(!el||!legend)return;
  el.innerHTML='';legend.innerHTML='';
  const colors=['#ef4444','#f59e0b','#8b5cf6','#3b82f6','#ec4899'];
  products.forEach((p,i)=>{
    const top=15+(i*20)%60;const left=5+(i*15)%25;const c=colors[i%colors.length];
    el.innerHTML+='<div class="doc-marker" style="top:'+top+'%;left:'+left+'%;width:55%;height:10%;border-color:'+c+'"><div class="doc-marker-label" style="background:'+c+'">'+(i+1)+'. '+p.name.substring(0,25)+'</div></div>';
    legend.innerHTML+='<div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400"><div class="w-3 h-3 rounded-sm" style="background:'+c+'"></div>'+(i+1)+'. '+p.name.substring(0,30)+'</div>';
  });
}
function switchTab(tab){
  document.querySelectorAll('.tab-panel').forEach(p=>p.classList.add('hidden'));
  document.querySelectorAll('.tab-btn').forEach(b=>{b.classList.remove('tab-active');b.classList.add('text-white/50');});
  document.getElementById('tab-'+tab).classList.remove('hidden');
  const btn=document.getElementById('tab-btn-'+tab);btn.classList.add('tab-active');btn.classList.remove('text-white/50');
}
function downloadPDF(){
  if(!lastResult)return;
  if(lastResult.pdf_error){alert('PDF Error: '+lastResult.pdf_error);return;}
  if(!lastResult.pdf_report){alert('PDF not available — please rescan.');return;}
  const link=document.createElement('a');
  link.href='data:application/pdf;base64,'+lastResult.pdf_report;
  link.download='TradeShield_Report_'+(lastResult.job_id||'audit')+'.pdf';
  document.body.appendChild(link);link.click();document.body.removeChild(link);
}
function rescan(){lastResult=null;selectedFile=null;previewDataURL=null;clearFile();hide('screen-result');hide('screen-error');show('screen-upload');window.scrollTo({top:0,behavior:'smooth'});}
function show(id){document.getElementById(id).classList.remove('hidden');}
function hide(id){document.getElementById(id).classList.add('hidden');}
const demoData={
  speaker:{title:'Bluetooth Speaker',id:'TS-X9',hs:'8518.21.0000',duty:'4.9% + active surcharges',sanctions:'CLEARED',notes:'Standard consumer electronics. Monitor for future expansions.',risk:'LOW',score:28,color:'#22c55e'},
  battery:{title:'Lithium Battery Pack',id:'TS-X7',hs:'8507.60.0000',duty:'3.4% + 25% Section 301',sanctions:'CLEARED',notes:'Section 301 tariffs apply. Requires UN38.3 test report for air freight. UFLPA supply chain risk from Xinjiang.',risk:'MEDIUM',score:61,color:'#f59e0b'},
  drone:{title:'Drone Parts — Dual-Use',id:'TS-X3',hs:'8806.24.0000',duty:'0% + EAR99 review',sanctions:'FLAGGED — EAR99',notes:'Dual-use export control risk. Requires BIS classification review. May need export license for certain destinations.',risk:'HIGH',score:88,color:'#ef4444'},
  solar:{title:'Solar Panels (UFLPA)',id:'TS-X5',hs:'8541.40.6020',duty:'14.5% + AD/CVD + Section 201',sanctions:'CLEARED',notes:'UFLPA enforcement active. Requires CSPB documentation for Xinjiang polysilicon. AD/CVD deposits required at entry.',risk:'HIGH',score:82,color:'#ef4444'}
};

function runDemo(key){
  const d=demoData[key];
  if(!d)return;
  const overlay=document.getElementById('demo-overlay');
  const status=document.getElementById('demo-status');
  if(!overlay||!status)return;
  const steps=['Connecting to OFAC...','Scanning HTS Schedule...','Checking EU Sanctions...','Calculating tariffs...','Generating report...'];
  overlay.classList.remove('hidden');overlay.style.display='flex';
  let i=0;
  const interval=setInterval(()=>{
    status.textContent=steps[i]||steps[steps.length-1];
    i++;
    if(i>=steps.length){
      clearInterval(interval);
      setTimeout(()=>{
        overlay.classList.add('hidden');overlay.style.display='none';
        const sc=d.score>=67?'#ef4444':d.score>=34?'#f59e0b':'#22c55e';
        const el=id=>document.getElementById(id);
        if(el('demo-title'))el('demo-title').textContent=d.title;
        if(el('demo-id'))el('demo-id').textContent='AUDIT ID: '+d.id;
        if(el('demo-hs'))el('demo-hs').textContent=d.hs;
        if(el('demo-duty'))el('demo-duty').textContent=d.duty;
        if(el('demo-sanctions')){el('demo-sanctions').textContent=d.sanctions;el('demo-sanctions').style.color=d.sanctions.includes('FLAGGED')?'#ef4444':'#22c55e';}
        if(el('demo-notes'))el('demo-notes').textContent=d.notes;
        if(el('demo-risk')){el('demo-risk').textContent=d.risk;el('demo-risk').style.color=sc;}
        if(el('demo-score')){el('demo-score').textContent=d.score;el('demo-score').style.color=sc;}
        if(el('demo-bar'))el('demo-bar').style.width=d.score+'%';
        if(el('demo-bar'))el('demo-bar').style.background=sc;
        document.querySelectorAll('.demo-btn').forEach(b=>b.classList.remove('border-2','border-[#0a7c6e]','bg-[#0a7c6e]/5'));
        const active=document.querySelector('[onclick="runDemo(\''+key+'\')"]');
        if(active)active.classList.add('border-2','border-[#0a7c6e]','bg-[#0a7c6e]/5');
      },300);
    }
  },400);
}

window.startScan=startScan;window.clearFile=clearFile;window.switchTab=switchTab;window.toggleProd=toggleProd;window.rescan=rescan;window.downloadPDF=downloadPDF;window.handleDrop=handleDrop;window.handleDragOver=handleDragOver;window.handleFileSelect=handleFileSelect;window.runDemo=runDemo;
