<script is:inline src="https://www.paypal.com/sdk/js?client-id=AQu2DIWmRI5-Lv8n_GnWuY5XjcEpfhTm9Vx8DBGgbh2Rh_nWwyU83OBByfBlr96o4gtotz0pqkjtk6kq&vault=true&intent=subscription" data-sdk-integration-source="button-factory"></script>
<script is:inline>
  var PLANS = {
    proMo:  'P-1NU513273T353600TNGWN7CQ',
    proYr:  'P-7GJ23119F6048484ANGWOEWY',
    premMo: 'P-6B6986702B7923417NGWOKBQ',
    premYr: 'P-4XK302596Y708620JNGWOMYA'
  };
  var isAnnual = false, rendered = false;

  function makeBtn(planId, cid) {
    if (!window.paypal) return;
    paypal.Buttons({
      style: { shape: 'rect', color: 'gold', layout: 'vertical', label: 'subscribe' },
      createSubscription: function(_d, a) { return a.subscription.create({ plan_id: planId }); },
      onApprove: function(d) { window.location.href = '/audit?subscriptionId=' + d.subscriptionID; },
      onError: function(e) { console.error('PayPal', e); }
    }).render('#' + cid);
  }

  function renderAll() {
    if (rendered) return;
    rendered = true;
    makeBtn(PLANS.proMo,  'paypal-pro-mo');
    makeBtn(PLANS.proYr,  'paypal-pro-yr');
    makeBtn(PLANS.premMo, 'paypal-prem-mo');
    makeBtn(PLANS.premYr, 'paypal-prem-yr');
  }

  function waitPP() { window.paypal ? renderAll() : setTimeout(waitPP, 200); }
  waitPP();

  function setBilling(annual) {
    isAnnual = annual;
    var thumb = document.getElementById('toggle-thumb');
    var track = document.getElementById('toggle');
    var lmo   = document.getElementById('lbl-mo');
    var lyr   = document.getElementById('lbl-yr');

    if (thumb) thumb.style.left        = annual ? '27px' : '1px';
    if (track) track.style.background  = annual ? '#0a7c6e' : '#d1d5db';
    if (lmo)   lmo.style.color         = annual ? '#9ca3af' : '#0b1e3d';
    if (lyr)   lyr.style.color         = annual ? '#0b1e3d' : '#9ca3af';

    document.getElementById('pro-amt').textContent  = annual ? '$249' : '$299';
    document.getElementById('prem-amt').textContent = annual ? '$666' : '$799';

    ['pro-orig', 'prem-orig', 'pro-note', 'prem-note'].forEach(function(id) {
      var el = document.getElementById(id);
      if (el) el.classList.toggle('hidden', !annual);
    });

    document.getElementById('paypal-pro-mo').classList.toggle('hidden', annual);
    document.getElementById('paypal-pro-yr').classList.toggle('hidden', !annual);
    document.getElementById('paypal-prem-mo').classList.toggle('hidden', annual);
    document.getElementById('paypal-prem-yr').classList.toggle('hidden', !annual);
  }

  function toggleBilling() { setBilling(!isAnnual); }

  function toggleFaq(btn) {
    var body = btn.nextElementSibling;
    var arr  = btn.querySelector('.faq-arr');
    body.classList.toggle('hidden');
    if (arr) arr.style.transform = body.classList.contains('hidden') ? '' : 'rotate(180deg)';
  }

  window.toggleBilling = toggleBilling;
  window.setBilling    = setBilling;
  window.toggleFaq     = toggleFaq;
</script>

</Layout>