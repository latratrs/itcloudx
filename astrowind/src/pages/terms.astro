export const prerender = true;
---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Terms and Conditions – TradeShield AI',
  description: 'TradeShield AI Terms and Conditions. Last updated March 7, 2026. Read carefully before using our AI-powered trade compliance tools.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="min-h-screen py-20 md:py-28 bg-gradient-to-b from-white to-[#f7f5f0] dark:from-gray-950 dark:to-gray-900 transition-colors">
    <div class="max-w-5xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h1 class="text-5xl md:text-6xl font-black text-gray-900 dark:text-white leading-tight">
          Terms and Conditions
        </h1>
        <p class="mt-6 text-xl text-gray-600 dark:text-gray-400">
          Last updated: March 7, 2026
        </p>
      </div>

      <div class="prose prose-slate dark:prose-invert max-w-none mx-auto text-gray-800 dark:text-gray-200 space-y-8">
        <p class="text-xl font-medium text-center">
          Please read these Terms and Conditions carefully before using the TradeShield AI Service operated by ITCloudX on behalf of Deccod.
        </p>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-12 mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
          1. Interpretation and Definitions
        </h2>

        <h3 class="text-2xl font-semibold mt-8 mb-4">1.1 Interpretation</h3>
        <p>
          Words with initial capital letters have defined meanings under the conditions below. Definitions apply in singular or plural.
        </p>

        <h3 class="text-2xl font-semibold mt-8 mb-4">1.2 Definitions</h3>
        <ul class="list-disc pl-6 space-y-3">
          <li><strong>Company</strong>: Deccod (referred to as “We”, “Us” or “Our”).</li>
          <li><strong>Operator</strong>: ITCloudX, acting as operator of the Service on behalf of Deccod.</li>
          <li><strong>Service</strong>: The website https://itcloudx.com and TradeShield AI tools (compliance scans, AI audits, integrations).</li>
          <li><strong>You</strong>: Individual or entity using the Service.</li>
          <li><strong>Country</strong>: United States</li>
        </ul>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
          2. Acknowledgment
        </h2>
        <p>
          These Terms govern your use of the Service and form a binding agreement between You and Deccod. By accessing or using the Service, You agree to these Terms and our current Data Audit Protocols.
        </p>
        <p class="mt-4">
          If You disagree with any part, You may not use the Service.
        </p>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
          3. AI & Algorithmic Responsibility
        </h2>
        <div class="bg-gray-50 dark:bg-gray-800 p-6 rounded-2xl border border-gray-200 dark:border-gray-700">
          <ul class="list-disc pl-6 space-y-4">
            <li><strong>Probabilistic Outputs</strong>: AI-generated results are probabilistic in nature. Always verify critical outputs with qualified professionals before acting.</li>
            <li><strong>OCR Processing</strong>: Data extracted from documents via OCR is prioritized over manual entry. Deccod is not liable for errors originating from low-quality source material provided by You.</li>
            <li><strong>Data Sources</strong>: Regulatory information is sourced in near real-time from public authorities. Delays or discrepancies may occur beyond our control.</li>
            <li><strong>Human Verification</strong>: Final human review is strongly recommended before relying on any AI-generated compliance recommendation.</li>
          </ul>
        </div>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
          4. Limitation of Liability
        </h2>
        <p>
          To the maximum extent permitted by law, Deccod's total aggregate liability shall be limited to the amount You paid for the Service in the preceding twelve (12) months — or USD $100 if no payment was made.
        </p>
        <p class="mt-4">
          In no event shall Deccod be liable for any indirect, incidental, special, consequential or punitive damages, including loss of profits, data or goodwill.
        </p>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
          5. "AS IS" and "AS AVAILABLE" Disclaimer
        </h2>
        <p>
          The Service is provided “AS IS” and “AS AVAILABLE” without warranties of any kind, express or implied. Use of the Service is at Your own risk.
        </p>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
          6. Governing Law
        </h2>
        <p>
          These Terms are governed by the laws of the State of California, United States, excluding its conflict of law rules.
        </p>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
          7. Disputes Resolution
        </h2>
        <p>
          If You have any concern or dispute, You agree to first attempt informal resolution by contacting us via the form on our 
          <a href="/contact" class="text-teal-600 dark:text-teal-400 hover:underline font-medium">Contact page</a>.
        </p>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
          8. Changes to These Terms
        </h2>
        <p>
          We may revise these Terms at any time. The updated version will be posted on this page with a revised date. Your continued use of the Service constitutes acceptance of the revised Terms.
        </p>

        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mt-16 mb-6 border-b border-gray-200 dark:border-gray-700 pb-4">
          9. Contact Us
        </h2>
        <p class="text-center mt-8">
          <a 
            href="/contact" 
            class="inline-flex items-center gap-3 bg-teal-600 hover:bg-teal-700 text-white font-bold text-lg px-10 py-5 rounded-xl shadow-lg transition-all hover:shadow-xl hover:scale-[1.02]"
          >
            Contact Us →
          </a>
        </p>
      </div>
    </div>
  </section>
</Layout>
