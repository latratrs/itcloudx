export const prerender = true;
---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About TradeShield AI – Los Angeles AI-Powered Trade Compliance',
  description: 'Los Angeles-based startup building AI tools for HS code classification, real-time sanctions screening, tariff intelligence, and global trade compliance. Prevent costly customs fines with intelligent automation.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section – matches homepage style -->
  <section class="relative bg-[#0b1e3d] overflow-hidden">
    <div class="absolute inset-0 opacity-10"
      style="background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 40px 40px;">
    </div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full opacity-20"
      style="background: radial-gradient(ellipse, #0a7c6e 0%, transparent 70%);">
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-24 pb-20 md:pt-32 md:pb-28 text-center">
      <span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-[#f0a820] text-xs font-bold uppercase tracking-widest px-5 py-2 rounded-full mb-6">
        <span class="w-2 h-2 rounded-full bg-[#f0a820] animate-pulse"></span>
        Los Angeles AI Startup
      </span>

      <h1 class="text-5xl md:text-7xl font-black text-white leading-tight tracking-tight">
        About TradeShield AI
      </h1>

      <p class="mt-8 text-xl md:text-2xl text-white/80 max-w-4xl mx-auto">
        Building the future of trade compliance — intelligent, instant, and indispensable.
      </p>
    </div>
  </section>

  <!-- Who We Are -->
  <section class="py-20 bg-white dark:bg-gray-950 transition-colors">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-black text-gray-900 dark:text-white mb-6">
          Who We Are
        </h2>
      </div>

      <div class="prose prose-lg md:prose-xl dark:prose-invert max-w-none mx-auto text-gray-700 dark:text-gray-300">
        <p class="lead text-xl text-center mb-10">
          TradeShield AI is a founder-led team in Los Angeles creating AI-native tools that solve real pain in global trade compliance.
        </p>

        <p>
          We live at the intersection of international regulations, supply chain complexity, and modern artificial intelligence. Our platform helps importers, e-commerce sellers, freight forwarders, and manufacturers avoid multimillion-dollar fines, shipment seizures, and compliance headaches — delivering broker-level accuracy in seconds, not days.
        </p>

        <p>
          Founded on the belief that compliance should be proactive, affordable, and invisible to growing businesses, we combine live regulatory data (CBP, OFAC, WCO, EU, UN) with powerful AI to turn complex rules into simple, actionable intelligence.
        </p>

        <p class="font-semibold text-center mt-10 text-lg">
          Small team. Direct founder access. Big impact on your bottom line.
        </p>
      </div>
    </div>
  </section>

  <!-- What We Solve -->
  <section class="py-20 bg-gradient-to-b from-white to-[#f7f5f0] dark:from-gray-950 dark:to-gray-900 transition-colors">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <div class="text-center mb-16">
        <h2 class="text-4xl md:text-5xl font-black text-gray-900 dark:text-white mb-6">
          What We Solve
        </h2>
        <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
          Trade compliance is broken — slow, expensive, and error-prone. We fix it with AI that thinks like an expert customs broker, but works 24/7 at a fraction of the cost.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
        <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg border border-gray-200 dark:border-gray-700 hover:shadow-2xl transition-all duration-300">
          <div class="w-16 h-16 bg-teal-100 dark:bg-teal-900/30 rounded-full flex items-center justify-center text-4xl mb-6 mx-auto">
            🔍
          </div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">
            HS Code Classification
          </h3>
          <p class="text-gray-700 dark:text-gray-300 text-center">
            Accurate, up-to-date codes against live CBP & WCO databases — preventing misclassification fines up to $1M+ per violation.
          </p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg border border-gray-200 dark:border-gray-700 hover:shadow-2xl transition-all duration-300">
          <div class="w-16 h-16 bg-teal-100 dark:bg-teal-900/30 rounded-full flex items-center justify-center text-4xl mb-6 mx-auto">
            🛡️
          </div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">
            Sanctions & Denied Party Screening
          </h3>
          <p class="text-gray-700 dark:text-gray-300 text-center">
            Real-time OFAC, UN, EU & global list checks — protecting your supply chain from compliance risk and reputational damage.
          </p>
        </div>

        <div class="bg-white dark:bg-gray-800 rounded-2xl p-8 shadow-lg border border-gray-200 dark:border-gray-700 hover:shadow-2xl transition-all duration-300">
          <div class="w-16 h-16 bg-teal-100 dark:bg-teal-900/30 rounded-full flex items-center justify-center text-4xl mb-6 mx-auto">
            📈
          </div>
          <h3 class="text-2xl font-bold text-gray-900 dark:text-white mb-4 text-center">
            Tariff & Risk Intelligence
          </h3>
          <p class="text-gray-700 dark:text-gray-300 text-center">
            Layered duty analysis (301, 232, 122, AD/CVD, UFLPA) + risk scoring — so you ship smarter and avoid delays & detention fees.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-20 bg-[#0b1e3d] text-white text-center">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-5xl font-black mb-6 leading-tight">
        Ready to Stop Compliance Risks?
      </h2>
      <p class="text-xl md:text-2xl opacity-90 mb-10">
        Run a free scan today — 60 seconds could save you $1,000,000 in fines and delays.
      </p>

      <a 
        href="/audit"
        class="inline-flex items-center gap-4 bg-[#0a7c6e] hover:bg-[#0d9485] text-white font-black text-xl px-12 py-6 rounded-2xl shadow-2xl transition-all hover:scale-105"
      >
        Start Free Compliance Scan →
        <span class="text-2xl">⚡</span>
      </a>

      <p class="mt-8 text-white/60 text-sm">
        No credit card • First 5 scans free • Powered by Deccod
      </p>
    </div>
  </section>
</Layout>