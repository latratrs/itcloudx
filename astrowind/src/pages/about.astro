---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'About TradeShield AI – Los Angeles AI-Powered Trade Compliance',
  description: 'Los Angeles-based startup building AI tools for HS code classification, real-time sanctions screening, tariff intelligence, and global trade compliance. Prevent costly customs fines with intelligent automation.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <!-- Hero Section -->
  <section class="relative bg-[#0b1e3d] overflow-hidden">
    <div class="absolute inset-0 opacity-10" style="background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full opacity-20" style="background: radial-gradient(ellipse, #0a7c6e 0%, transparent 70%);"></div>
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-24 pb-20 md:pt-32 md:pb-28 text-center">
      <span class="inline-flex items-center gap-2 bg-white/10 border border-white/20 text-[#f0a820] text-xs font-bold uppercase tracking-widest px-5 py-2 rounded-full mb-6">
        <span class="w-2 h-2 rounded-full bg-[#f0a820] animate-pulse"></span>
        Los Angeles AI Startup
      </span>
      <h1 class="text-5xl md:text-7xl font-black text-white leading-tight tracking-tight">
        About TradeShield AI
      </h1>
      <p class="mt-8 text-xl md:text-2xl text-white/80 max-w-4xl mx-auto">
        Bridging the gap between complex global trade regulations and modern AI efficiency.
      </p>
    </div>
  </section>

  <!-- Main Content Section -->
  <section class="py-20 bg-white dark:bg-gray-950 transition-colors">
    <div class="max-w-4xl mx-auto px-6 lg:px-8">
      <div class="prose prose-lg md:prose-xl dark:prose-invert max-w-none mx-auto text-gray-700 dark:text-gray-300">
        
        <!-- What We Solve -->
        <h2 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white mb-6 text-center">What We Solve</h2>
        <p>
          TradeShield AI is a Los Angeles-based startup founded by Yuriy Altshul to bridge the gap between complex global trade regulations and modern AI efficiency. Born from a vision to make high-level compliance accessible to every growing business, we are currently in our early stages of funding and rapid development.
        </p>
        <p>
          We live at the intersection of international law, supply chain logic, and AI-native engineering. Our platform serves importers, e-commerce sellers, and manufacturers who can't afford to wait days for a compliance check. We deliver broker-level precision in seconds—preventing multimillion-dollar fines and shipment seizures before they happen.
        </p>

        <!-- Tech Stack -->
        <div class="mt-16 pt-12 border-t border-gray-200 dark:border-gray-700">
          <h2 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white mb-6 text-center">Our Tech Stack: Powered by Google</h2>
          <p>
            As an early-stage startup, we’ve built our foundation on the most robust infrastructure available. TradeShield AI is engineered entirely within the Google Cloud Ecosystem. By leveraging Firebase, Firebase Functions, Gemini AI and Vertex AI, we provide our users with:
          </p>
          <ul class="list-disc pl-8 space-y-4">
            <li>
              <strong>Real-Time Scalability:</strong> High-speed scanning that grows with your transaction volume.
            </li>
            <li>
              <strong>Data Integrity:</strong> Secure, cloud-native processing of sensitive trade documents.
            </li>
            <li>
              <strong>Instant Intelligence:</strong> Serverless architecture that pushes live updates from global regulatory bodies (CBP, OFAC, WCO, EU, UN) directly to your dashboard.
            </li>
          </ul>
        </div>

        <!-- Small Team, Global Reach -->
        <div class="mt-16 pt-12 border-t border-gray-200 dark:border-gray-700">
          <h2 class="text-3xl md:text-4xl font-black text-gray-900 dark:text-white mb-6 text-center">Small Team, Global Reach</h2>
          <p>
            We are a founder-led, lean operation. This means you get direct access to Yuriy Altshul and the core engineering team. We believe that compliance should be proactive, affordable, and invisible—allowing you to focus on growth while our AI handles the shield.
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-20 bg-[#0b1e3d] text-white text-center">
    <div class="max-w-4xl mx-auto px-6">
      <h2 class="text-3xl md:text-5xl font-black mb-6 leading-tight">
        Ready to Stop Compliance Risks?
      </h2>
      <p class="text-xl md:text-2xl opacity-90 mb-10">
        Run a free scan today — 60 seconds could save you $1,000,000 in fines and delays.
      </p>
      <a href="/audit" class="inline-flex items-center gap-4 bg-[#0a7c6e] hover:bg-[#0d9485] text-white font-black text-xl px-12 py-6 rounded-2xl shadow-2xl transition-all hover:scale-105">
        Start Free Compliance Scan →
        <span class="text-2xl">⚡</span>
      </a>
      <p class="mt-8 text-white/60 text-sm">
        No credit card • First 5 scans free • Powered by Deccod
      </p>
    </div>
  </section>
</Layout>
