export const prerender = true;
---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'Contact TradeShield AI – Los Angeles Trade Compliance Startup',
  description: 'Get in touch with our Los Angeles-based team building AI-powered trade compliance tools. Inquiries about HS code scanning, sanctions screening, tariff intelligence, or partnerships welcome.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="py-16 md:py-24 bg-gradient-to-b from-white to-[#f7f5f0] dark:from-gray-950 dark:to-gray-900 transition-colors duration-300">
    <div class="max-w-6xl mx-auto px-6 lg:px-8">
      <!-- Headline -->
      <div class="text-center mb-12 md:mb-16">
        <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-gray-900 dark:text-white leading-tight">
          Let's Connect
        </h1>
        <p class="mt-4 md:mt-6 text-lg md:text-2xl text-gray-700 dark:text-gray-300 max-w-3xl mx-auto">
          Reach out to explore our AI-powered trade compliance solutions. Interested in HS code classification, sanctions screening, or partnerships? 
          Let's talk.
        </p>
      </div>

      <!-- Two-column layout -->
      <div class="grid md:grid-cols-5 gap-10 lg:gap-16 items-start">
        <!-- Left: Embedded Google Form -->
        <div class="md:col-span-3 bg-white dark:bg-gray-950 rounded-3xl p-6 lg:p-8 shadow-xl transition-colors duration-300">
          <h2 class="text-2xl md:text-3xl font-bold text-gray-900 dark:text-white mb-6 text-center md:text-left">
            Send Your Message
          </h2>
          <p class="text-gray-700 dark:text-gray-300 mb-6 leading-relaxed text-center md:text-left">
            Tell us about your project, compliance needs, or partnership idea. As a small Los Angeles-based team, you'll get a direct response from the founder.
          </p>

          <!-- Form container – dark blue background in both modes -->
          <div class="w-full h-[900px] md:h-[820px] lg:h-[860px] rounded-xl overflow-hidden bg-[#0b1e3d] shadow-inner">
            <iframe 
              src="https://docs.google.com/forms/d/e/1FAIpQLScTvuznEW7pZRTMH8km21aQ4JGOjSfTTPiZlqmtAgjX1i9L9w/viewform?embedded=true"
              width="100%" 
              height="100%" 
              frameborder="0" 
              marginheight="0" 
              marginwidth="0"
              scrolling="auto"
              style="border: none;"
              class="dark:invert dark:brightness-90 dark:contrast-125 dark:grayscale-0 transition-all duration-300"
            >
              Loading form…
            </iframe>
          </div>

          <p class="text-center text-sm text-gray-500 dark:text-gray-400 mt-4">
            Form hosted securely by Google • Your data is protected
          </p>
        </div>

        <!-- Right: Partnerships + location text -->
        <div class="md:col-span-2 space-y-10 lg:space-y-12">
          <div class="text-gray-700 dark:text-gray-300">
            <h3 class="text-xl font-bold text-gray-900 dark:text-white mb-4">Partnerships</h3>
            <p class="leading-relaxed">
              Open for collaboration. We love working with founders, agencies, SaaS companies, 
              and enterprises who want to bring powerful AI solutions to market. 
              No gatekeepers — direct access to the team.
            </p>
            <p class="mt-4 text-sm italic">
              Currently focused on AI-powered trade compliance, tariff intelligence, and sanctions screening tools.
            </p>
            <p class="mt-6 text-sm font-medium text-gray-900 dark:text-gray-100">
              Based in Los Angeles, California<br />
              A focused, agile team operating with a flat structure—ensuring direct founder involvement in every client relationship.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Internal Links: related pages -->
  <section class="py-14 bg-[#f7f5f0] border-t border-gray-200">
    <div class="max-w-6xl mx-auto px-6">
      <div class="grid sm:grid-cols-4 gap-5">
        <a href="/pricing" class="group flex flex-col bg-white border border-gray-200 hover:border-[#0a7c6e] rounded-xl p-5 transition-all hover:shadow-md">
          <span class="text-xl mb-2">💼</span>
          <h3 class="font-bold text-gray-900 text-sm mb-1 group-hover:text-[#0a7c6e] transition-colors">Pricing Plans</h3>
          <p class="text-xs text-gray-600 flex-1">Explore our compliance plans from free to enterprise.</p>
          <span class="mt-3 text-[#0a7c6e] font-bold text-xs">View Plans →</span>
        </a>
        <a href="/blog" class="group flex flex-col bg-white border border-gray-200 hover:border-[#0a7c6e] rounded-xl p-5 transition-all hover:shadow-md">
          <span class="text-xl mb-2">📰</span>
          <h3 class="font-bold text-gray-900 text-sm mb-1 group-hover:text-[#0a7c6e] transition-colors">Trade Intelligence</h3>
          <p class="text-xs text-gray-600 flex-1">Latest news on tariffs, sanctions, and trade compliance.</p>
          <span class="mt-3 text-[#0a7c6e] font-bold text-xs">Read Blog →</span>
        </a>
        <a href="/terms" class="group flex flex-col bg-white border border-gray-200 hover:border-[#0a7c6e] rounded-xl p-5 transition-all hover:shadow-md">
          <span class="text-xl mb-2">📄</span>
          <h3 class="font-bold text-gray-900 text-sm mb-1 group-hover:text-[#0a7c6e] transition-colors">Terms of Service</h3>
          <p class="text-xs text-gray-600 flex-1">Review our terms before subscribing to a compliance plan.</p>
          <span class="mt-3 text-[#0a7c6e] font-bold text-xs">Read Terms →</span>
        </a>
        <a href="/privacy" class="group flex flex-col bg-white border border-gray-200 hover:border-[#0a7c6e] rounded-xl p-5 transition-all hover:shadow-md">
          <span class="text-xl mb-2">🔒</span>
          <h3 class="font-bold text-gray-900 text-sm mb-1 group-hover:text-[#0a7c6e] transition-colors">Privacy Policy</h3>
          <p class="text-xs text-gray-600 flex-1">How we protect your data and shipment documents.</p>
          <span class="mt-3 text-[#0a7c6e] font-bold text-xs">Read Policy →</span>
        </a>
      </div>
    </div>
  </section>

</Layout>
