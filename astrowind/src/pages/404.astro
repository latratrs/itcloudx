---
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: '404 – Page Not Found | TradeShield AI',
  description: 'The page you are looking for does not exist. Return to TradeShield AI – your AI-powered trade compliance platform for HS code classification, sanctions screening, and tariff intelligence.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <section class="min-h-screen flex items-center justify-center bg-gradient-to-b from-white to-[#f7f5f0] dark:from-gray-950 dark:to-gray-900 transition-colors duration-300">
    <div class="text-center px-6 max-w-2xl">
      <!-- 404 Icon / Number -->
      <div class="text-8xl md:text-9xl font-black text-gray-300 dark:text-gray-700 mb-6">
        404
      </div>

      <!-- Message -->
      <h1 class="text-3xl md:text-5xl font-bold text-gray-900 dark:text-white mb-6 leading-tight">
        Page Not Found
      </h1>

      <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 mb-10">
        Sorry, the page you're looking for doesn't exist or has been moved. 
        It might have been removed, renamed, or is temporarily unavailable.
      </p>

      <!-- Helpful links / CTA -->
      <div class="flex flex-col sm:flex-row gap-6 justify-center">
        <a 
          href="/"
          class="inline-flex items-center justify-center gap-3 bg-gray-900 dark:bg-white hover:bg-gray-800 dark:hover:bg-gray-100 text-white dark:text-gray-900 font-bold text-lg px-10 py-4 rounded-xl shadow-lg transition-all hover:shadow-xl hover:scale-[1.02]"
        >
          Return to Homepage
        </a>

        <a 
          href="/audit"
          class="inline-flex items-center justify-center gap-3 bg-teal-600 hover:bg-teal-700 text-white font-bold text-lg px-10 py-4 rounded-xl shadow-lg transition-all hover:shadow-xl hover:scale-[1.02]"
        >
          Run Free Compliance Scan →
        </a>
      </div>

      <!-- Secondary links -->
      <div class="mt-10 text-gray-600 dark:text-gray-400">
        <p class="mb-4">Still can't find what you're looking for?</p>
        <a 
          href="/contact" 
          class="text-teal-600 dark:text-teal-400 hover:underline font-medium"
        >
          Contact our Los Angeles team →
        </a>
      </div>
    </div>
  </section>
</Layout>
