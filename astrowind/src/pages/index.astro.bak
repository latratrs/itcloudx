<script>
async function loadTicker() {
  const track = document.getElementById('news-ticker-track');
  if (!track) return;
  let items = [];
  try {
    const res = await fetch('/rss.xml');
    const text = await res.text();
    const xml = new DOMParser().parseFromString(text, 'text/xml');
    xml.querySelectorAll('item').forEach(post => {
      const title = post.querySelector('title')?.textContent || '';
      const rawLink = post.querySelector('link')?.textContent || '';
      const link = rawLink ? rawLink.replace('https://itcloudx.com', '') : '/blog';
      if (title) items.push({ title, link });
    });
  } catch(e) {
    items = [
      { title: 'New 2026 US Tariff Rules: What Every Importer Must Know', link: '/blog' },
      { title: 'OFAC Sanctions Update: High-Risk Jurisdictions Added', link: '/blog' },
      { title: 'HS Code Misclassification: How AI Catches Errors Before Customs', link: '/blog' },
    ];
  }
  if (!items.length) return;
  const all = [...items, ...items, ...items];
  track.innerHTML = all.map(i =>
    `<a href="${i.link}" class="hover:text-white transition-colors inline-flex items-center gap-2"><span class="text-[#0fb39d]">▶</span>${i.title}</a><span class="text-white/20 mx-6">|</span>`
  ).join('');
  let pos = 0;
  (function tick() {
    pos -= 0.5;
    if (Math.abs(pos) >= track.scrollWidth / 3) pos = 0;
    track.style.transform = `translateX(${pos}px)`;
    requestAnimationFrame(tick);
  })();
}
document.addEventListener('DOMContentLoaded', loadTicker);
</script>
</Layout>

<script>
  // ═══ FIREBASE CONFIG ═══
  // TODO: Replace with your actual Firebase config when ready
  const FIREBASE_FUNCTION_URL = '/api/scan'; // Will route to Firebase Cloud Function
  const MAX_FILE_SIZE_MB = 25;
  const ALLOWED_TYPES = ['application/pdf','text/csv','application/vnd.ms-excel',
    'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
    'image/jpeg','image/png','image/tiff'];

  // ═══ FILE TYPE DETECTION ═══
  function getFileCategory(file: File): { label: string; icon: string; reliable: string } {
    const ext = file.name.split('.').pop()?.toLowerCase();
    if (['csv','xlsx','xls'].includes(ext || '')) return { label: 'STRUCTURED', icon: '📊', reliable: '100%' };
    if (ext === 'pdf') return { label: 'PDF', icon: '📄', reliable: '98%' };
    if (['jpg','jpeg','png','tiff','tif'].includes(ext || '')) return { label: 'IMAGE', icon: '🖼️', reliable: '95% OCR' };
    return { label: 'DOC', icon: '📁', reliable: '95%' };
  }

  // ═══ DOM REFS ═══
  const fileInput = document.getElementById('file-input') as HTMLInputElement;
  const dropZone = document.getElementById('drop-zone');
  const fileSelectedEl = document.getElementById('file-selected');
  const fileNameEl = document.getElementById('file-name');
  const fileTypeBadge = document.getElementById('file-type-badge');

  let selectedFile: File | null = null;

  function handleFile(file: File) {
    // Validate size
    if (file.size > MAX_FILE_SIZE_MB * 1024 * 1024) {
      showError(`File too large. Maximum size is ${MAX_FILE_SIZE_MB}MB.`);
      return;
    }
    selectedFile = file;
    const cat = getFileCategory(file);
    if (fileNameEl) fileNameEl.textContent = `${cat.icon} ${file.name} · ${(file.size/1024/1024).toFixed(2)}MB · Sherlock reliability: ${cat.reliable}`;
    if (fileTypeBadge) fileTypeBadge.textContent = cat.label;
    if (fileSelectedEl) fileSelectedEl.classList.remove('hidden');
  }

  // Drop zone events
  if (dropZone && fileInput) {
    dropZone.addEventListener('click', () => fileInput.click());
    dropZone.addEventListener('dragover', (e) => { e.preventDefault(); dropZone.classList.add('border-[#0a7c6e]','bg-[#0a7c6e]/5'); });
    dropZone.addEventListener('dragleave', () => dropZone.classList.remove('border-[#0a7c6e]','bg-[#0a7c6e]/5'));
    dropZone.addEventListener('drop', (e: DragEvent) => {
      e.preventDefault();
      dropZone.classList.remove('border-[#0a7c6e]','bg-[#0a7c6e]/5');
      const file = e.dataTransfer?.files[0];
      if (file) handleFile(file);
    });
    fileInput.addEventListener('change', () => {
      if (fileInput.files?.[0]) handleFile(fileInput.files[0]);
    });
  }

  // ═══ PIPELINE STEP UPDATER ═══
  const pipelineSteps = [
    { id: 'step-upload',   label: 'Secure Upload',         pct: 15 },
    { id: 'step-ocr',      label: 'Sherlock Vision OCR',   pct: 35 },
    { id: 'step-hs',       label: 'HS Classification',     pct: 55 },
    { id: 'step-sanctions',label: 'Sanctions Screening',   pct: 75 },
    { id: 'step-tariff',   label: 'Tariff Layer Analysis', pct: 88 },
    { id: 'step-pdf',      label: 'PDF Report Generation', pct: 100 },
  ];

  function activateStep(stepId: string) {
    const el = document.getElementById(stepId);
    if (el) {
      el.classList.add('bg-[#0a7c6e]/10','border','border-[#0a7c6e]/30');
      el.classList.remove('bg-gray-50');
      const icon = el.querySelector('.step-icon');
      if (icon) icon.textContent = '⚡';
      el.style.color = '#0a7c6e';
      el.style.fontWeight = 'bold';
    }
  }

  function completeStep(stepId: string) {
    const el = document.getElementById(stepId);
    if (el) {
      el.classList.add('bg-green-50','border-green-200');
      el.classList.remove('bg-[#0a7c6e]/10','border-[#0a7c6e]/30');
      const icon = el.querySelector('.step-icon');
      if (icon) icon.textContent = '✓';
      el.style.color = '#16a34a';
    }
  }

  function showState(state: 'upload' | 'processing' | 'error') {
    ['state-upload','state-processing','state-error'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.classList.add('hidden');
    });
    const target = document.getElementById(`state-${state}`);
    if (target) target.classList.remove('hidden');
  }

  function showError(msg: string) {
    const errEl = document.getElementById('error-message');
    if (errEl) errEl.textContent = msg;
    showState('error');
  }

  (window as any).resetWidget = function() {
    selectedFile = null;
    if (fileSelectedEl) fileSelectedEl.classList.add('hidden');
    if (fileInput) fileInput.value = '';
    // Reset pipeline steps
    pipelineSteps.forEach(s => {
      const el = document.getElementById(s.id);
      if (el) {
        el.className = 'pipeline-step text-[10px] text-gray-300 flex items-center gap-1.5 p-2 rounded-lg bg-gray-50';
        el.style.color = '';
        el.style.fontWeight = '';
        const icon = el.querySelector('.step-icon');
        if (icon) icon.textContent = '⏳';
      }
    });
    showState('upload');
  };

  // ═══ MAIN SCAN FUNCTION — Silent Data Bridge ═══
  (window as any).startScan = async function() {
    const email = (document.getElementById('scan-email') as HTMLInputElement)?.value?.trim();
    const company = (document.getElementById('scan-company') as HTMLInputElement)?.value?.trim();

    if (!email || !email.includes('@')) {
      alert('Please enter a valid work email to receive your report.');
      return;
    }

    // Switch to processing state
    showState('processing');
    const scanBar = document.getElementById('scan-bar');
    const scanPercent = document.getElementById('scan-percent');
    const scanLabel = document.getElementById('scan-label');
    const processingTitle = document.getElementById('processing-title');
    const processingSub = document.getElementById('processing-sub');

    function setProgress(pct: number, label: string) {
      if (scanBar) scanBar.style.width = `${pct}%`;
      if (scanPercent) scanPercent.textContent = `${pct}%`;
      if (scanLabel) scanLabel.textContent = label;
    }

    try {
      // STEP 1: Upload file (or email-only if no file)
      activateStep('step-upload');
      setProgress(5, 'Preparing secure upload...');

      let uploadPayload: FormData | null = null;

      if (selectedFile) {
        uploadPayload = new FormData();
        uploadPayload.append('file', selectedFile);
        uploadPayload.append('email', email);
        uploadPayload.append('company', company || '');
        uploadPayload.append('filename', selectedFile.name);
        uploadPayload.append('fileType', getFileCategory(selectedFile).label);
      }

      setProgress(15, 'Uploading to secure cloud...');
      if (processingTitle) processingTitle.textContent = 'Uploading Document...';
      if (processingSub) processingSub.textContent = 'Sending to TradeShield AI via encrypted connection';

      // Try real Firebase upload — fall back to redirect if not configured
      let scanJobId: string | null = null;

      try {
        const response = await fetch(FIREBASE_FUNCTION_URL, {
          method: 'POST',
          body: uploadPayload || JSON.stringify({ email, company }),
          headers: uploadPayload ? {} : { 'Content-Type': 'application/json' },
          signal: AbortSignal.timeout(10000),
        });

        if (response.ok) {
          const result = await response.json();
          scanJobId = result.jobId || null;
        }
      } catch (fetchErr) {
        // Firebase not configured yet — continue with UI demo + redirect
        console.log('TradeShield: API not yet configured, using demo flow');
      }

      completeStep('step-upload');

      // STEP 2: OCR (simulated pipeline — real steps happen server-side)
      activateStep('step-ocr');
      setProgress(25, 'Sherlock Vision OCR processing...');
      if (processingTitle) processingTitle.textContent = 'Reading Document...';
      if (processingSub) processingSub.textContent = 'Extracting product data with Sherlock Vision';
      await delay(900);
      completeStep('step-ocr');

      // STEP 3: HS Classification
      activateStep('step-hs');
      setProgress(50, 'AI HS Code classification...');
      if (processingTitle) processingTitle.textContent = 'Classifying Products...';
      if (processingSub) processingSub.textContent = 'Matching products against WCO HS nomenclature';
      await delay(800);
      completeStep('step-hs');

      // STEP 4: Sanctions
      activateStep('step-sanctions');
      setProgress(70, 'Screening OFAC · UN · EU sanctions...');
      if (processingTitle) processingTitle.textContent = 'Sanctions Screening...';
      if (processingSub) processingSub.textContent = 'Checking 5 global enforcement databases';
      await delay(700);
      completeStep('step-sanctions');

      // STEP 5: Tariff
      activateStep('step-tariff');
      setProgress(85, 'Analyzing tariff layers...');
      if (processingTitle) processingTitle.textContent = 'Tariff Analysis...';
      if (processingSub) processingSub.textContent = 'Calculating stacked duty exposure';
      await delay(600);
      completeStep('step-tariff');

      // STEP 6: PDF
      activateStep('step-pdf');
      setProgress(95, 'Generating compliance PDF...');
      if (processingTitle) processingTitle.textContent = 'Building Your Report...';
      if (processingSub) processingSub.textContent = 'Preparing audit-ready PDF document';
      await delay(500);
      completeStep('step-pdf');

      setProgress(100, 'Complete!');
      if (processingTitle) processingTitle.textContent = 'Scan Complete!';
      if (processingSub) processingSub.textContent = `Report sent to ${email}`;

      // Redirect to audit page with context
      await delay(800);
      window.location.href = `/audit`;

    } catch (err: any) {
      showError(err?.message || 'Upload failed. Please check your connection and try again.');
    }
  };

  function delay(ms: number) { return new Promise(r => setTimeout(r, ms)); }

  // ═══ LIVE FINE TICKER ═══
  let fineAmount = 4520900;
  const fineTicker = document.getElementById('fine-ticker');
  setInterval(() => {
    fineAmount += Math.floor(Math.random() * 800 + 200);
    if (fineTicker) fineTicker.textContent = '$' + fineAmount.toLocaleString();
  }, 3000);

  // ═══ INTERACTIVE DEMO ═══
  const demoData: Record<string, any> = {
    speaker: { title:'Bluetooth Speaker', hs:'8518.21.0000', duty:'4.9% + active surcharges', sanctions:'CLEARED', sanctionsClass:'font-bold text-green-400', notes:'Standard consumer electronics. Monitor for future tariff expansions.', score:28, riskLabel:'LOW', riskColor:'text-green-400' },
    battery: { title:'Lithium Battery Pack', hs:'8507.60.0020', duty:'3.4% + stacked duties', sanctions:'REVIEW', sanctionsClass:'font-bold text-yellow-400', notes:'IATA declaration required. Possible tariff layering. UN38.3 test report needed.', score:61, riskLabel:'MEDIUM', riskColor:'text-yellow-400' },
    drone:   { title:'Drone Parts', hs:'8806.21.0000', duty:'0% + EAR review required', sanctions:'FLAGGED', sanctionsClass:'font-bold text-red-400', notes:'EAR dual-use technology. Export license check required. Military crossover risk.', score:88, riskLabel:'HIGH', riskColor:'text-red-400' },
    solar:   { title:'Solar Panels', hs:'8541.40.6020', duty:'25% base + stacked surcharges', sanctions:'FLAGGED', sanctionsClass:'font-bold text-red-400', notes:'UFLPA forced labor audit required. Multiple stacked duties. CBP withhold release order risk.', score:82, riskLabel:'HIGH', riskColor:'text-red-400' },
  };

  (window as any).runDemo = function(key: string) {
    const d = demoData[key];
    if (!d) return;
    const overlay = document.getElementById('demo-overlay');
    const status = document.getElementById('demo-status');
    if (overlay) { overlay.classList.remove('hidden'); overlay.style.display = 'flex'; }

    const steps = ['Parsing Manifest...', 'CBP Tariff Lookup...', 'OFAC Screening...', 'TradeShield Final Audit...'];
    let i = 0;
    const interval = setInterval(() => {
      if (status) status.textContent = steps[i] || steps[steps.length-1];
      i++;
      if (i > steps.length) {
        clearInterval(interval);
        if (overlay) { overlay.classList.add('hidden'); overlay.style.display = 'none'; }
        const set = (id: string, val: string, cls?: string) => { const el = document.getElementById(id); if (el) { el.textContent = val; if (cls) el.className = cls; } };
        set('demo-title', d.title);
        set('demo-hs', d.hs);
        set('demo-duty', d.duty);
        set('demo-sanctions', d.sanctions, d.sanctionsClass);
        set('demo-notes', d.notes);
        const scoreEl = document.getElementById('demo-score');
        if (scoreEl) scoreEl.innerHTML = `${d.score}<span class="text-sm font-normal text-white/30">/100</span>`;
        set('demo-risk-label', d.riskLabel, `font-bold ${d.riskColor}`);
        const bar = document.getElementById('demo-risk-bar');
        if (bar) bar.style.width = `${d.score}%`;
      }
    }, 550);

    document.querySelectorAll('.demo-btn').forEach(btn => {
      (btn as HTMLElement).classList.remove('border-[#0a7c6e]','bg-[#0a7c6e]/5','border-2');
      (btn as HTMLElement).classList.add('border','border-gray-200');
    });
    const target = document.querySelector(`[onclick="runDemo('${key}')"]`) as HTMLElement;
    if (target) { target.classList.add('border-2','border-[#0a7c6e]','bg-[#0a7c6e]/5'); target.classList.remove('border','border-gray-200'); }
  };

  (window as any).runDemo('speaker');
</script>
