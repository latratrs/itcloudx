---
export const prerender = true;
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'TradeShield AI — Stop Customs Fines Before They Start',
  description: 'AI scans invoices for correct HS codes, current tariffs, OFAC/EU/UN sanctions. Free 5 scans, full compliance report in 60 seconds. Avoid $1M+ fines.',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>

  <!-- ═══════════════════ HERO ═══════════════════ -->
  <section class="relative bg-gradient-to-br from-[#0b1e3d] via-[#0b1e3d] to-[#0a7c6e]/30 overflow-hidden">
    <div class="absolute inset-0 opacity-10"
      style="background-image: linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px); background-size: 40px 40px;">
    </div>
    <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[900px] h-[500px] rounded-full opacity-20 pointer-events-none"
      style="background: radial-gradient(ellipse, #0a7c6e 0%, transparent 70%);">
    </div>


    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 pt-16 pb-14 md:pt-24 md:pb-20">

      <div class="flex justify-center mb-6"><span class="inline-flex items-center gap-2 border border-[#f0a820]/40 text-[#f0a820] text-[11px] font-black uppercase tracking-widest px-5 py-2 rounded-full"><span class="w-2 h-2 rounded-full bg-[#f0a820] animate-pulse inline-block"></span>Live Tariff &amp; Sanctions Intelligence · Continuously Updated</span></div>
      <h1 class="text-center text-4xl md:text-6xl lg:text-7xl font-black leading-tight tracking-tight text-white mb-4">
        Stop Customs Fines<br>
        <span style="color:#0fb39d">Before They Start.</span>
      </h1>

      <p class="text-center text-lg md:text-xl text-white/70 max-w-3xl mx-auto mb-3">
        TradeShield AI delivers accurate HS codes, duty rates, sanctions flags and a full PDF report in <strong class="text-white">60 seconds.</strong>
      </p>
      <p class="text-center text-sm text-white/40 mb-10">Free for first 5 scans · No credit card · Powered by TradeShield AI on Google Cloud</p>

      <!-- ═══ UPLOAD WIDGET — Silent Data Bridge ═══ -->
      <div class="max-w-3xl mx-auto bg-white rounded-3xl shadow-2xl shadow-black/50 overflow-hidden border-4 border-[#0a7c6e]/20 mb-8" id="scan-widget">

        <!-- Terminal header -->
        <div class="bg-[#0b1e3d] px-6 py-4 flex items-center justify-between border-b border-white/10">
          <div class="flex items-center gap-3">
            <div class="flex gap-1.5">
              <div class="w-3 h-3 rounded-full bg-[#b8361e]"></div>
              <div class="w-3 h-3 rounded-full bg-[#f0a820]"></div>
              <div class="w-3 h-3 rounded-full bg-[#0fb39d] animate-pulse"></div>
            </div>
            <span class="text-white font-bold text-sm tracking-tight">🛡️ TRADESHIELD AI — SECURE COMPLIANCE TERMINAL</span>
          </div>
          <span class="text-[#0fb39d] text-[10px] font-mono font-bold uppercase hidden md:block">5 free scans · no card</span>
        </div>

        <div class="p-8">

          <!-- STATE 1: Drop Zone -->
          <div id="state-upload">
            <div id="drop-zone"
              class="group border-2 border-dashed border-gray-200 rounded-2xl p-10 text-center cursor-pointer hover:border-[#0a7c6e] hover:bg-[#0a7c6e]/5 transition-all duration-300">
              <div class="text-5xl mb-4 transform group-hover:scale-110 transition-transform duration-300" id="drop-icon">📄</div>
              <p class="font-black text-xl text-[#0b1e3d] mb-1" id="drop-title">Drop invoice, manifest, or product list</p>
              <p class="text-gray-400 text-sm mb-5" id="drop-sub">PDF · CSV · Excel · JPG · PNG · TIFF — any format</p>
              <div class="flex justify-center flex-wrap gap-2">
                <span class="bg-gray-100 text-gray-500 text-xs font-bold px-3 py-1 rounded-full">PDF</span>
                <span class="bg-gray-100 text-gray-500 text-xs font-bold px-3 py-1 rounded-full">CSV</span>
                <span class="bg-gray-100 text-gray-500 text-xs font-bold px-3 py-1 rounded-full">XLSX</span>
                <span class="bg-gray-100 text-gray-500 text-xs font-bold px-3 py-1 rounded-full">JPG</span>
                <span class="bg-gray-100 text-gray-500 text-xs font-bold px-3 py-1 rounded-full">PNG</span>
              </div>
              <input type="file" id="file-input" class="hidden" accept=".pdf,.csv,.xlsx,.xls,.jpg,.jpeg,.png,.tiff,.tif">
            </div>

            <div id="file-selected" class="hidden mt-4 bg-green-50 border border-green-200 rounded-xl px-4 py-3 flex items-center gap-3">
              <span class="text-green-600 text-xl">✓</span>
              <span id="file-name" class="text-sm text-green-800 font-medium flex-1"></span>
              <span id="file-type-badge" class="text-xs font-black uppercase px-2 py-0.5 rounded-full bg-[#0a7c6e] text-white"></span>
            </div>

            <div class="mt-6 grid md:grid-cols-2 gap-4 relative" style="z-index:30;" id="pre-scan-fields">
              <input type="email" id="scan-email" placeholder="Work email for report *" required
                class="w-full bg-gray-50 border border-gray-200 rounded-xl px-5 py-3.5 text-sm focus:outline-none focus:border-[#0a7c6e] focus:ring-2 focus:ring-[#0a7c6e]/20" style="position:relative;z-index:30;pointer-events:auto;">
              <input type="text" id="scan-company" placeholder="Company / Amazon Seller name"
                class="w-full bg-gray-50 border border-gray-200 rounded-xl px-5 py-3.5 text-sm focus:outline-none focus:border-[#0a7c6e] focus:ring-2 focus:ring-[#0a7c6e]/20" style="position:relative;z-index:30;pointer-events:auto;">
            </div>
            <button onclick="event.stopPropagation();startScan()" id="scan-btn" style="position:relative;z-index:30;"
              class="w-full mt-4 bg-[#0a7c6e] hover:bg-[#0fb39d] text-white font-black text-base py-4 rounded-xl shadow-xl flex items-center justify-center gap-3 transition-all duration-200 hover:scale-[1.01]">
              RUN FREE COMPLIANCE AUDIT → <span class="text-xl">⚡</span>
            </button>
            <p class="text-center text-xs text-gray-400 mt-3">
              🔒 Sherlock Vision OCR · 256-bit encryption · Data deleted after scan · GDPR compliant
            </p>
          </div>

          <!-- STATE 2: Processing (Sherlock Vision Pipeline) -->
          <div id="state-processing" class="hidden">
            <div class="text-center mb-6">
              <div class="w-16 h-16 border-4 border-[#0fb39d]/20 border-t-[#0fb39d] rounded-full animate-spin mx-auto mb-4"></div>
              <p class="font-black text-[#0b1e3d] text-lg" id="processing-title">Uploading Securely...</p>
              <p class="text-gray-400 text-sm mt-1" id="processing-sub">Your document is being sent to TradeShield AI</p>
            </div>
            <div class="space-y-2 mb-4">
              <div class="flex justify-between text-xs font-bold text-[#0b1e3d] mb-1">
                <span id="scan-label">Initializing Sherlock Vision...</span>
                <span id="scan-percent">0%</span>
              </div>
              <div class="h-2.5 bg-gray-100 rounded-full overflow-hidden">
                <div id="scan-bar" class="h-full bg-gradient-to-r from-[#0a7c6e] to-[#0fb39d] rounded-full transition-all duration-500" style="width:0%"></div>
              </div>
            </div>
            <div class="grid grid-cols-2 gap-2" id="pipeline-steps">
              <div class="pipeline-step text-[10px] text-gray-300 flex items-center gap-1.5 p-2 rounded-lg bg-gray-50" id="step-upload">
                <span class="step-icon">⏳</span> Secure Upload
              </div>
              <div class="pipeline-step text-[10px] text-gray-300 flex items-center gap-1.5 p-2 rounded-lg bg-gray-50" id="step-ocr">
                <span class="step-icon">⏳</span> Sherlock Vision OCR
              </div>
              <div class="pipeline-step text-[10px] text-gray-300 flex items-center gap-1.5 p-2 rounded-lg bg-gray-50" id="step-hs">
                <span class="step-icon">⏳</span> HS Classification
              </div>
              <div class="pipeline-step text-[10px] text-gray-300 flex items-center gap-1.5 p-2 rounded-lg bg-gray-50" id="step-sanctions">
                <span class="step-icon">⏳</span> Sanctions Screening
              </div>
              <div class="pipeline-step text-[10px] text-gray-300 flex items-center gap-1.5 p-2 rounded-lg bg-gray-50" id="step-tariff">
                <span class="step-icon">⏳</span> Tariff Layer Analysis
              </div>
              <div class="pipeline-step text-[10px] text-gray-300 flex items-center gap-1.5 p-2 rounded-lg bg-gray-50" id="step-pdf">
                <span class="step-icon">⏳</span> PDF Report Generation
              </div>
            </div>
          </div>

          <!-- STATE 3: Error -->
          <div id="state-error" class="hidden text-center py-6">
            <div class="text-5xl mb-4">⚠️</div>
            <p class="font-black text-[#b8361e] text-lg mb-2">Upload Failed</p>
            <p class="text-gray-500 text-sm mb-6" id="error-message">Please try again or contact support.</p>
            <button onclick="resetWidget()" class="bg-[#0b1e3d] text-white font-bold px-6 py-3 rounded-xl text-sm hover:bg-[#0a7c6e] transition-colors">
              Try Again
            </button>
          </div>

        </div>
      </div>

      <!-- Trust strip -->
      <div class="flex flex-wrap justify-center gap-6 text-white/40 text-xs font-bold uppercase tracking-widest">
        <span>✓ Live CBP Tariffs</span>
        <span>✓ OFAC / UN / EU Sanctions</span>
        <span>✓ Sherlock Vision OCR</span>
        <span>✓ No Data Stored</span>
        <span>✓ GDPR Ready</span>
      </div>

    </div>
  </section>

  <!-- ═══════════════════ LIVE FINE TICKER ═══════════════════ -->
  <section class="bg-white py-10 border-b border-gray-100">
    <div class="max-w-6xl mx-auto px-4 grid grid-cols-2 md:grid-cols-4 gap-6 text-center">
      <div>
        <div class="text-3xl font-black text-[#b8361e]" id="fine-ticker">$4,520,900</div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">Fines Avoided Today (est.)</p>
      </div>
      <div class="border-l border-gray-100">
        <div class="text-3xl font-black text-[#0b1e3d]">60s</div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">Avg. Audit Speed</p>
      </div>
      <div class="border-l border-gray-100">
        <div class="text-3xl font-black text-[#0b1e3d]">38%</div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">Imports Have HS Issues</p>
      </div>
      <div class="border-l border-gray-100">
        <div class="text-3xl font-black text-[#0a7c6e]">24/7</div>
        <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mt-1">Live Sanctions Screening</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ STATS BAR ═══════════════════ -->
  <section class="bg-gradient-to-r from-[#b8361e] to-[#c27d0e] py-12">
    <div class="max-w-6xl mx-auto px-6 grid md:grid-cols-3 gap-8 text-center text-white">
      <div>
        <div class="text-5xl md:text-6xl font-black">$1M+</div>
        <p class="text-white/80 mt-2 text-sm uppercase tracking-wide">Max civil fine per HS misclassification</p>
      </div>
      <div class="border-t md:border-t-0 md:border-l md:border-r border-white/30 pt-8 md:pt-0">
        <div class="text-5xl md:text-6xl font-black">$500/day</div>
        <p class="text-white/80 mt-2 text-sm uppercase tracking-wide">Port detention fees per held container</p>
      </div>
      <div class="border-t md:border-t-0 border-white/30 pt-8 md:pt-0">
        <div class="text-5xl md:text-6xl font-black">Rising</div>
        <p class="text-white/80 mt-2 text-sm uppercase tracking-wide">Enforcement wave: criminal risk increasing</p>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ WHO THIS IS FOR ═══════════════════ -->
  <section class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0a7c6e] mb-3 block">Who Needs This</span>
        <h2 class="text-3xl md:text-5xl font-black text-[#0b1e3d]">Built for everyone who moves goods across borders.</h2>
      </div>
      <div class="grid md:grid-cols-4 gap-6">
        <div class="bg-[#f7f5f0] rounded-2xl p-6 hover:shadow-xl transition-all hover:-translate-y-1 border border-transparent hover:border-[#0a7c6e]/20">
          <div class="text-4xl mb-4">📦</div>
          <h3 class="font-black text-lg text-[#0b1e3d] mb-2">Importers & Distributors</h3>
          <p class="text-gray-500 text-sm">Catch tariff layering before fines hit your shipment.</p>
        </div>
        <div class="bg-[#f7f5f0] rounded-2xl p-6 hover:shadow-xl transition-all hover:-translate-y-1 border border-transparent hover:border-[#0a7c6e]/20">
          <div class="text-4xl mb-4">🛒</div>
          <h3 class="font-black text-lg text-[#0b1e3d] mb-2">Amazon & E-com Sellers</h3>
          <p class="text-gray-500 text-sm">Pre-check duties and sanctions on China stock before ordering.</p>
        </div>
        <div class="bg-[#f7f5f0] rounded-2xl p-6 hover:shadow-xl transition-all hover:-translate-y-1 border border-transparent hover:border-[#0a7c6e]/20">
          <div class="text-4xl mb-4">🚢</div>
          <h3 class="font-black text-lg text-[#0b1e3d] mb-2">Freight Forwarders</h3>
          <p class="text-gray-500 text-sm">Bulk-screen client shipments — prevent delays and liability.</p>
        </div>
        <div class="bg-[#f7f5f0] rounded-2xl p-6 hover:shadow-xl transition-all hover:-translate-y-1 border border-transparent hover:border-[#0a7c6e]/20">
          <div class="text-4xl mb-4">🏭</div>
          <h3 class="font-black text-lg text-[#0b1e3d] mb-2">Manufacturers</h3>
          <p class="text-gray-500 text-sm">Ensure UFLPA & multi-country compliance across all components.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ INTERACTIVE DEMO ═══════════════════ -->
  <section class="py-24 bg-[#f7f5f0]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0a7c6e] mb-3 block">Interactive Risk Demo</span>
        <h2 class="text-3xl md:text-5xl font-black text-[#0b1e3d]">Don't guess. See how the AI thinks.</h2>
        <p class="text-gray-500 mt-3 max-w-lg mx-auto">Click a product to watch TradeShield AI run a real-time audit across 5 global databases.</p>
      </div>
      <div class="grid lg:grid-cols-2 gap-10 items-start">
        <div class="bg-white rounded-2xl p-8 border border-gray-200 shadow-sm">
          <p class="text-xs font-black uppercase tracking-widest text-gray-400 mb-5">Click a Sample Product</p>
          <div class="space-y-3" id="demo-list">
            <button onclick="runDemo('speaker')" class="demo-btn w-full flex items-center justify-between p-4 rounded-xl border-2 border-[#0a7c6e] bg-[#0a7c6e]/5 transition-all">
              <span class="flex items-center gap-3 font-bold text-[#0b1e3d] text-sm">📻 Bluetooth Speaker — China Origin</span>
              <span class="text-[#0a7c6e] font-black text-xs">SCAN</span>
            </button>
            <button onclick="runDemo('battery')" class="demo-btn w-full flex items-center justify-between p-4 rounded-xl border border-gray-200 hover:border-[#0a7c6e] transition-all">
              <span class="flex items-center gap-3 font-bold text-[#0b1e3d] text-sm">🔋 Lithium Battery Pack — China</span>
              <span class="text-gray-400 font-black text-xs">SCAN</span>
            </button>
            <button onclick="runDemo('drone')" class="demo-btn w-full flex items-center justify-between p-4 rounded-xl border border-gray-200 hover:border-[#0a7c6e] transition-all">
              <span class="flex items-center gap-3 font-bold text-[#0b1e3d] text-sm">🚁 Drone Parts — Dual-Use Risk</span>
              <span class="text-gray-400 font-black text-xs">SCAN</span>
            </button>
            <button onclick="runDemo('solar')" class="demo-btn w-full flex items-center justify-between p-4 rounded-xl border border-gray-200 hover:border-[#0a7c6e] transition-all">
              <span class="flex items-center gap-3 font-bold text-[#0b1e3d] text-sm">☀️ Solar Panels — UFLPA + Stacked Tariffs</span>
              <span class="text-gray-400 font-black text-xs">SCAN</span>
            </button>
          </div>
          <div class="mt-8 border-t border-gray-100 pt-6">
            <p class="text-xs font-black uppercase tracking-widest text-gray-400 mb-3">Risk Heatmap</p>
            <div class="space-y-2">
              <div class="flex items-center gap-3"><div class="w-2 h-2 rounded-full bg-green-400"></div><span class="text-xs text-gray-500 flex-1">Bluetooth Speaker</span><div class="h-2 bg-gray-100 rounded-full flex-1 overflow-hidden"><div class="h-full bg-green-400 rounded-full" style="width:28%"></div></div><span class="text-xs font-bold text-gray-500 w-8">28</span></div>
              <div class="flex items-center gap-3"><div class="w-2 h-2 rounded-full bg-yellow-400"></div><span class="text-xs text-gray-500 flex-1">Lithium Battery</span><div class="h-2 bg-gray-100 rounded-full flex-1 overflow-hidden"><div class="h-full bg-yellow-400 rounded-full" style="width:61%"></div></div><span class="text-xs font-bold text-gray-500 w-8">61</span></div>
              <div class="flex items-center gap-3"><div class="w-2 h-2 rounded-full bg-red-500"></div><span class="text-xs text-gray-500 flex-1">Drone Parts</span><div class="h-2 bg-gray-100 rounded-full flex-1 overflow-hidden"><div class="h-full bg-red-500 rounded-full" style="width:88%"></div></div><span class="text-xs font-bold text-gray-500 w-8">88</span></div>
              <div class="flex items-center gap-3"><div class="w-2 h-2 rounded-full bg-red-600"></div><span class="text-xs text-gray-500 flex-1">Solar Panels</span><div class="h-2 bg-gray-100 rounded-full flex-1 overflow-hidden"><div class="h-full bg-red-600 rounded-full" style="width:82%"></div></div><span class="text-xs font-bold text-gray-500 w-8">82</span></div>
            </div>
          </div>
        </div>
        <div class="bg-[#0b1e3d] rounded-2xl p-8 text-white shadow-2xl relative overflow-hidden">
          <div id="demo-overlay" class="absolute inset-0 bg-[#0b1e3d]/95 backdrop-blur-sm z-10 hidden flex-col items-center justify-center">
            <div class="w-14 h-14 border-4 border-[#0fb39d]/20 border-t-[#0fb39d] rounded-full animate-spin mb-5"></div>
            <p class="font-mono text-xs text-[#0fb39d] uppercase tracking-[0.2em]" id="demo-status">Connecting to OFAC...</p>
          </div>
          <div class="flex justify-between items-start mb-6">
            <div>
              <div class="text-[#0fb39d] font-mono text-[10px] uppercase tracking-widest mb-1">Audit ID: TS-X9</div>
              <h3 class="text-xl font-black" id="demo-title">Bluetooth Speaker</h3>
            </div>
            <div class="bg-white/10 px-4 py-2 rounded-xl text-center border border-white/10">
              <div class="text-[10px] text-white/40 uppercase font-black mb-1">Risk Score</div>
              <div class="text-2xl font-black text-[#0fb39d]" id="demo-score">28<span class="text-sm font-normal text-white/30">/100</span></div>
            </div>
          </div>
          <div class="space-y-3 mb-6">
            <div class="bg-white/5 p-4 rounded-xl border border-white/10 flex justify-between items-center">
              <span class="text-white/40 text-xs">HS Code</span>
              <span class="font-mono font-bold text-[#f0a820]" id="demo-hs">8518.21.0000</span>
            </div>
            <div class="bg-white/5 p-4 rounded-xl border border-white/10 flex justify-between items-center">
              <span class="text-white/40 text-xs">Duty / Tariff Stack</span>
              <span class="font-bold text-white text-sm" id="demo-duty">4.9% + active surcharges</span>
            </div>
            <div class="bg-white/5 p-4 rounded-xl border border-white/10 flex justify-between items-center">
              <span class="text-white/40 text-xs">Sanctions Status</span>
              <span id="demo-sanctions" class="font-bold text-green-400">CLEARED</span>
            </div>
            <div class="bg-white/5 p-4 rounded-xl border border-white/10">
              <span class="text-white/40 text-xs block mb-2">AI Compliance Notes</span>
              <p class="text-sm text-white/80 italic" id="demo-notes">Standard consumer electronics. Monitor for future expansions.</p>
            </div>
          </div>
          <div class="bg-white/5 rounded-xl p-4 border border-white/10 mb-4">
            <div class="flex justify-between text-xs mb-2">
              <span class="text-white/40">Risk Level</span>
              <span id="demo-risk-label" class="font-bold text-green-400">LOW</span>
            </div>
            <div class="h-2.5 bg-white/10 rounded-full overflow-hidden">
              <div id="demo-risk-bar" class="h-full rounded-full transition-all duration-700" style="width:28%; background: linear-gradient(90deg, #0fb39d, #f0a820, #b8361e)"></div>
            </div>
          </div>
          <a href="/audit" class="block w-full text-center bg-[#0a7c6e] hover:bg-[#0fb39d] text-white font-black py-4 rounded-xl text-sm transition-all">
            Run Your Real Shipment →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════ HOW IT WORKS ═══════════════════ -->
  <section id="how-it-works" class="py-20 bg-white">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-14">
        <span class="text-xs font-bold uppercase tracking-widest text-[#0a7c6e] mb-3 block">How It Works</span>
        <h2 class="text-3xl md:text-5xl font-black text-[#0b1e3d]">From Upload to Compliance Report in 60 Seconds</h2>
      </div>
      <div class="grid md:grid-cols-3 gap-8 relative">
        <div class="hidden md:block absolute top-10 left-[36%] text-2xl text-[#0a7c6e] font-black pointer-events-none">→</div>
        <div class="hidden md:block absolute top-10 right-[36%] text-2xl text-[#0a7c6e] font-black pointer-events-none">→</div>
        <div class="text-center">
          <div class="w-20 h-20 bg-[#0b1e3d] rounded-2xl flex items-center justify-center text-4xl mx-auto mb-5">📤</div>
          <div class="text-xs font-black uppercase tracking-widest text-[#0a7c6e] mb-2">Step 1</div>
          <h3 class="font-black text-xl text-[#0b1e3d] mb-3">Upload</h3>
          <p class="text-gray-500 text-sm">Invoice, manifest, CSV, or photo of shipping docs. Any format — Sherlock Vision OCR handles the rest.</p>
        </div>
        <div class="text-center">
          <div class="w-20 h-20 bg-[#0a7c6e] rounded-2xl flex items-center justify-center text-4xl mx-auto mb-5">🤖</div>
